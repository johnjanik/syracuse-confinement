{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\n# Corrected audit: minimax separation delta(c0,c) = min over primitive k of\n# max over witnesses |chi_k(W^2)-1|, on the valid two-descent range c <= c0+2.\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef descend_tables(c, c0):\n    Qc = 3**c; PHI = 2*3**(c-1); inv2 = pow(2,-1,Qc)\n    m = 3**(c-1); F = {}\n    for x in units(m):\n        t=(3*x+1)%Qc; row=[0]*(PHI+1); v=t\n        for b in range(1,PHI+1): v=(v*inv2)%Qc; row[b]=v\n        F[x]=row\n    level=c-1\n    while level>c0:\n        mlo=3**(level-1); new=units(mlo)\n        x0=new[0]; x1=(x0+mlo)%(3**level)\n        rho=(F[x1][1]*pow(F[x0][1],-1,Qc))%Qc\n        import random\n        rnd=random.Random(1)\n        for _ in range(40):\n            xh=rnd.choice(new); b=rnd.randrange(1,PHI+1); d=rnd.randrange(1,3)\n            xp=(xh+d*mlo)%(3**level)\n            assert (F[xp][b]*pow(F[xh][b],-1,Qc))%Qc==pow(rho,d,Qc), \"purity fail\"\n        Fn={}\n        for xh in new:\n            t=(3*xh+1); row=[0]*(PHI+1)\n            for b in range(1,PHI+1):\n                v=(t*pow(inv2,b,3**level))%(3**level)\n                delta=(v-(v%mlo))//mlo\n                row[b]=(F[xh][b]*pow(rho,delta,Qc))%Qc\n            Fn[xh]=row\n        F=Fn; level-=1\n    return F\n\ndef audit(c, c0):\n    Qc=3**c; F=descend_tables(c,c0)\n    Q0=3**c0; U0=units(Q0); phi0=len(U0)\n    succ={}; mult={}\n    for x in U0:\n        for b0 in range(1,phi0+1):\n            succ[(x,b0)]=((3*x+1)*pow(pow(2,b0,Q0),-1,Q0))%Q0\n            mult[(x,b0)]=F[x][b0]\n    cycles=[]\n    for x in U0:\n        for b1 in range(1,phi0+1):\n            v1=succ[(x,b1)]\n            if v1==x: cycles.append([(x,b1)])\n            for b2 in range(1,phi0+1):\n                if succ[(v1,b2)]==x and v1>x: cycles.append([(x,b1),(v1,b2)])\n    def prod(cy):\n        p=1\n        for e in cy: p=(p*mult[e])%Qc\n        return p\n    P=[(prod(cy),len(cy)) for cy in cycles]\n    # witness elements W^2 (principal units)\n    Ws=set()\n    for i in range(len(P)):\n        for j in range(i+1,len(P)):\n            (p1,l1),(p2,l2)=P[i],P[j]\n            W=(pow(p1,l2,Qc)*pow(p2,-l1,Qc))%Qc\n            W2=(W*W)%Qc\n            if W2!=1: Ws.add(W2)\n    Ws=list(Ws)\n    if not Ws: return None\n    # dlog base 4 over principal units mod 3^c (cyclic of order 3^{c-1})\n    ordp=3**(c-1); dl={}; p=1\n    for j in range(ordp): dl[p]=j; p=(p*4)%Qc\n    import cmath, math\n    idxs=[dl[w] for w in Ws if w in dl]\n    # chi_k(W2) = e(2 pi i k t / 3^{c-1}), t = dlog4(W2); separation per k = max over W\n    best_min=None; worst_k=None\n    for k in range(1,ordp):\n        if k%3==0: continue\n        sep=max(abs(cmath.exp(2j*math.pi*k*t/ordp)-1) for t in idxs)\n        if best_min is None or sep<best_min: best_min=sep; worst_k=k\n    return len(cycles),len(Ws),best_min,worst_k\n\nprint(f\"{'c0':>3} {'c':>3} {'cycles<=2':>9} {'#W^2':>6} {'minimax sep':>12} {'worst k':>8}\")\nfor (c0,cc) in ((2,3),(2,4),(3,4),(3,5),(4,5),(4,6),(5,6),(5,7)):\n    r=audit(cc,c0)\n    if r: print(f\"{c0:>3} {cc:>3} {r[0]:>9} {r[1]:>6} {r[2]:>12.6f} {r[3]:>8}\")\n    else: print(f\"{c0:>3} {cc:>3}  no witnesses\")\nPY"}