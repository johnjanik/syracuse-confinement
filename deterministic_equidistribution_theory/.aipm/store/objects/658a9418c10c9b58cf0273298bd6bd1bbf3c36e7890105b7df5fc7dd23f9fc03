{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\nfrom math import gcd\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef build_par(Q, s, kchar):\n    U = units(Q); phi = len(U); idx = {a:i for i,a in enumerate(U)}\n    dlog = {}; p = 1\n    for j in range(phi): dlog[p] = j; p = (p*2) % Q\n    inv = {a: pow(a, -1, Q) for a in U}\n    chi = {a: np.exp(2j*np.pi*kchar*dlog[a]/phi) for a in U}\n    n = 2*phi\n    M = np.zeros((n,n), complex)\n    den = 1.0 - 2.0**(-(1+s)*phi)\n    for a in U:\n        t = (3*a+1) % Q\n        for ap in U:\n            b0 = dlog[(t*inv[ap]) % Q] % phi\n            if b0 == 0: b0 = phi\n            W = (3.0**s) * 2.0**(-(1+s)*b0) / den\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau] += W * chi[a]\n    return M\n\ndef rho(M): return max(abs(np.linalg.eigvals(M)))\n\ndef cond_exp(k, r):\n    \"\"\"conductor exponent c of chi_k at level 3^r: 3^{r-c} || k (k=0 -> c=0).\"\"\"\n    if k == 0: return 0\n    v = 0; kk = k\n    while kk % 3 == 0: kk //= 3; v += 1\n    return r - v\n\nprint(\"=== gamma_c by conductor, residue x parity (collapse check: equal across r) ===\")\nfor s in (0.0, 1.0):\n    print(f\"--- s={s:.0f} ---\")\n    for r,Q in ((2,9),(3,27),(4,81),(5,243)):\n        phi = len(units(Q))\n        r0 = rho(build_par(Q,s,0))\n        byc = {}\n        for k in range(1, phi//2+1):\n            c = cond_exp(k, r)\n            v = rho(build_par(Q,s,k))/r0\n            if c not in byc or v > byc[c][0]: byc[c] = (v,k)\n        out = \"  \".join(f\"c={c}:{byc[c][0]:.6f}(k={byc[c][1]})\" for c in sorted(byc))\n        print(f\"Q={Q:4d}: {out}\")\nPY"}