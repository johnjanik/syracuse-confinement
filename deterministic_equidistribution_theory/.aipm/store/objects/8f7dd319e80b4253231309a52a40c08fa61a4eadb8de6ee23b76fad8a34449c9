{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 300 python3 - <<'PY'\nimport numpy as np\n# eta_k = max over units a mod 3^k of |sum_{b>=1} 2^{-b} e(a 2^b / 3^k)|\nprint(\"k   eta_k      3*eta_k^2   eta_k*sqrt(3)\")\nprods=1.0; cum=[]\nfor k in range(1,13):\n    Q=3**k; P=2*3**(k-1)\n    # 2^b mod Q cycles with period P; closed form: sum over r=1..P of 2^{-r} zeta^{2^r} / (1-2^{-P})\n    pw=[pow(2,r,Q) for r in range(1,P+1)]\n    best=0\n    units=[a for a in range(1,Q) if a%3] if k<=7 else None\n    if units is None:\n        # sample units for large k (orbit symmetry: a and a*2^j give same |S|; a -> -a conj)\n        units=set()\n        g=2\n        # representatives of units modulo the action a ~ a*2^j (orbit size P) => # classes = phi(Q)/P = 1? phi=2*3^{k-1}=P => single orbit per sign!? phi(Q)=2*3^{k-1}=P exactly => all units are powers of 2 mod Q!\n        units={1}\n    for a in units:\n        S=sum(2.0**(-r)*np.exp(2j*np.pi*((a*pw[r-1])%Q)/Q) for r in range(1,P+1))/(1-2.0**(-P))\n        v=abs(S)\n        if v>best: best=v\n    prods*=3*best**2; cum.append(prods)\n    print(f\"{k:2d}  {best:.6f}  {3*best**2:.6f}  {best*np.sqrt(3):.6f}\")\nprint(\"\\ncumulative prod_{j<=k} (3 eta_j^2):\", [f\"{x:.4f}\" for x in cum])\nprint(\"sum over L of prod_{k<=L}(3 eta_k^2):\", f\"{sum(cum):.4f}\", \"(plus 1 for u=0)\")\nPY"}