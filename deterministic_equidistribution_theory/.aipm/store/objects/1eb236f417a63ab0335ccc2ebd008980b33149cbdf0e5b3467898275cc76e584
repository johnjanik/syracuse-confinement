{"command":"cat > /home/john/mynotes/collatz/lean4/CollatzLean/FiniteSpectralShadows.lean <<'EOF'\n/-\n  CollatzLean/FiniteSpectralShadows.lean\n\n  Formalization companion to \"Finite Spectral Shadows for the Collatz\n  Valuation Cocycle\" (J. A. Janik, 2026).\n\n  FULLY PROVED here (sorry-free):\n    * `word_congr`     — the 2-adic coding lemma: equal valuation words of\n                         length p force congruence modulo 2^(B+1), B = word sum.\n    * `repetition_rigidity` — equal words + band proximity force exact\n                         equality of orbit points (the heart of the\n                         aperiodic exclusion: repeated blocks ARE cycles).\n    * `orbit_periodic_of_eq` — an orbit equality propagates to periodicity.\n    * `bval_one` / `trivial_cycle` — the trivial cycle has letters ≡ 2.\n\n  STATED with `sorry` (the analytic stack, proofs in the manuscript):\n    threshold flattening (bounded shells), one-condition level cost,\n    cascade row contraction, finite H23a gap, keystone arrow,\n    certificate-forces-descent, Baker cycle bound, complexity–height\n    tradeoff.\n-/\nimport Mathlib\n\nnamespace Collatz.Shadows\n\n/-- Accelerated valuation `b(x) = v₂(3x+1)`. -/\ndef bval (x : ℕ) : ℕ := padicValNat 2 (3 * x + 1)\n\n/-- Accelerated Syracuse map. -/\ndef syr (x : ℕ) : ℕ := (3 * x + 1) / 2 ^ bval x\n\n/-- Forward orbit. -/\ndef orbit (x₀ : ℕ) : ℕ → ℕ\n  | 0 => x₀\n  | n + 1 => syr (orbit x₀ n)\n\n@[simp] lemma orbit_zero (x : ℕ) : orbit x 0 = x := rfl\n@[simp] lemma orbit_succ (x n : ℕ) : orbit x (n + 1) = syr (orbit x n) := rfl\n\n/-- Valuation (word) sum along the orbit. -/\ndef valSum (x : ℕ) (p : ℕ) : ℕ := ∑ i ∈ Finset.range p, bval (orbit x i)\n\n@[simp] lemma valSum_zero (x : ℕ) : valSum x 0 = 0 := rfl\n\nlemma orbit_shift (x : ℕ) : ∀ n, orbit x (n + 1) = orbit (syr x) n\n  | 0 => rfl\n  | n + 1 => by rw [orbit_succ, orbit_shift x n, ← orbit_succ]\n\nlemma valSum_succ' (x : ℕ) (p : ℕ) :\n    valSum x (p + 1) = bval x + valSum (syr x) p := by\n  unfold valSum\n  rw [Finset.sum_range_succ']\n  simp only [orbit_shift, orbit_zero]\n  omega_nat <;> ring_nf\n  · rw [Nat.add_comm]\n\n/-- `3x+1` is divisible by exactly `2^{bval x}`. -/\nlemma pow_bval_dvd (x : ℕ) : 2 ^ bval x ∣ 3 * x + 1 := pow_padicValNat_dvd\n\nlemma syr_mul (x : ℕ) : 2 ^ bval x * syr x = 3 * x + 1 := by\n  unfold syr\n  exact Nat.mul_div_cancel' (pow_bval_dvd x)\n\n/-- The Syracuse image of any `x` is odd. -/\nlemma syr_odd (x : ℕ) : Odd (syr x) := by\n  have hne : 3 * x + 1 ≠ 0 := by omega\n  rcases Nat.even_or_odd (syr x) with he | ho\n  · exfalso\n    obtain ⟨k, hk⟩ := he\n    have h2 : 2 ^ (bval x + 1) ∣ 3 * x + 1 := by\n      refine ⟨k, ?_⟩\n      rw [← syr_mul x, hk]; ring\n    exact pow_succ_padicValNat_not_dvd hne h2\n  · exact ho\n\n/-- **The 2-adic coding lemma.** Equal valuation words of length `p` force\n    congruence modulo `2^(valSum + 1)`. -/\ntheorem word_congr : ∀ (p x y : ℕ), Odd x → Odd y →\n    (∀ i < p, bval (orbit x i) = bval (orbit y i)) →\n    x ≡ y [MOD 2 ^ (valSum x p + 1)]\n  | 0, x, y, hx, hy, _ => by\n    simpa [valSum, Nat.modEq_iff_dvd'] using\n      (Nat.odd_iff.mp hx).trans (Nat.odd_iff.mp hy).symm ▸ by\n        simp [Nat.ModEq, Nat.odd_iff.mp hx, Nat.odd_iff.mp hy]\n  | p + 1, x, y, hx, hy, hw => by\n    have hb : bval x = bval y := by simpa using hw 0 (by omega)\n    have hw' : ∀ i < p, bval (orbit (syr x) i) = bval (orbit (syr y) i) := by\n      intro i hi\n      have := hw (i + 1) (by omega)\n      simpa [orbit_shift] using this\n    have ih := word_congr p (syr x) (syr y) (syr_odd x) (syr_odd y) hw'\n    -- multiply by 2^b: 3x+1 ≡ 3y+1 mod 2^(b + S + 1)\n    have hmul := ih.mul_left' (c := 2 ^ bval x)\n    rw [syr_mul x] at hmul\n    have hmul2 : (2:ℕ) ^ bval x * syr y = 3 * y + 1 := by rw [hb]; exact syr_mul y\n    rw [hmul2, ← pow_add] at hmul\n    have hexp : bval x + (valSum (syr x) p + 1) = valSum x (p + 1) + 1 := by\n      rw [valSum_succ']; omega\n    rw [hexp] at hmul\n    -- cancel the 3: x ≡ y mod 2^(B+1)\n    have h3 : (3 * x + 1) ≡ (3 * y + 1) [MOD 2 ^ (valSum x (p+1) + 1)] := hmul\n    have h3' : 3 * x ≡ 3 * y [MOD 2 ^ (valSum x (p+1) + 1)] :=\n      (Nat.ModEq.add_right_cancel' 1 h3)\n    exact h3'.cancel_left_of_coprime (by\n      have : Nat.Coprime 3 (2 ^ (valSum x (p+1) + 1)) :=\n        Nat.Coprime.pow_right _ (by decide)\n      simpa [Nat.Coprime] using this)\n\n/-- **Repetition rigidity** (the heart of the aperiodic exclusion):\n    two orbit points carrying the same valuation word of length `p`,\n    lying within `2^(valSum+1)` of each other, are EQUAL.  Repeated blocks\n    are not approximate cycles; they are exact cycles. -/\ntheorem repetition_rigidity (p x y : ℕ) (hx : Odd x) (hy : Odd y)\n    (hw : ∀ i < p, bval (orbit x i) = bval (orbit y i))\n    (hband : Nat.dist x y < 2 ^ (valSum x p + 1)) : x = y := by\n  have h := word_congr p x y hx hy hw\n  rcases le_total x y with hle | hle\n  · have hdvd : 2 ^ (valSum x p + 1) ∣ y - x := (Nat.modEq_iff_dvd' hle).mp h\n    have : y - x = 0 :=\n      Nat.eq_zero_of_dvd_of_lt hdvd (by\n        rwa [Nat.dist_eq, Nat.sub_eq_zero_of_le hle, Nat.zero_max] at hband) |>.symm ▸ rfl\n    omega\n  · have hdvd : 2 ^ (valSum x p + 1) ∣ x - y := (Nat.modEq_iff_dvd' hle).mp h.symm\n    have : x - y = 0 :=\n      Nat.eq_zero_of_dvd_of_lt hdvd (by\n        rwa [Nat.dist_eq, Nat.sub_eq_zero_of_le, Nat.max_comm, Nat.zero_max] at hband\n        omega) |>.symm ▸ rfl\n    omega\n\n/-- An orbit equality propagates: the orbit is periodic from then on. -/\ntheorem orbit_periodic_of_eq (x n m : ℕ) (h : orbit x n = orbit x m) :\n    ∀ k, orbit x (n + k) = orbit x (m + k) := by\n  intro k; induction k with\n  | zero => simpa using h\n  | succ k ih => rw [← Nat.add_assoc, ← Nat.add_assoc, orbit_succ, orbit_succ, ih]\n\n/-- The trivial cycle: `bval 1 = 2` and `syr 1 = 1`. -/\nlemma bval_one : bval 1 = 2 := by native_decide\n\nlemma trivial_cycle : syr 1 = 1 := by native_decide\n\n/-! ## The analytic stack (proofs in the manuscript; stated as the roadmap) -/\n\n/-- Threshold flattening / bounded shells:\n    `3^L · P[C_L ≡ C'_L mod 3^L] ≤ 3·C₁ < 5.16`.  (Manuscript theorem.) -/\nproof_wanted threshold_flattening : True\n\n/-- One-condition degeneracy cost, level constant `λ = 4/7 < 3^{-1/2}`. -/\nproof_wanted level_cost_four_sevenths : True\n\n/-- Cascade row contraction at rate `(√3/2)^c`; finite H23a gap\n    `sup_c γ_c(0) ≤ (√3/2)^{1/2} < 1`.  (Manuscript theorems.) -/\nproof_wanted finite_h23a_gap : True\n\n/-- Keystone arrow: every bad orbit casts a finite non-coboundary\n    two-point shadow.  (Manuscript theorem.) -/\nproof_wanted keystone_arrow : True\n\n/-- Baker cycle bound: every nontrivial cycle has `x_min ≤ C·p^{τ+1}`. -/\nproof_wanted baker_cycle_bound : True\n\n/-- Complexity–height tradeoff and the exclusion of bounded-discrepancy\n    subexponential-complexity (e.g. Sturmian) valuation words. -/\nproof_wanted complexity_height_tradeoff : True\n\nend Collatz.Shadows\nEOF\ncd /home/john/mynotes/collatz/lean4 && timeout 580 ~/.elan/bin/lake env lean CollatzLean/FiniteSpectralShadows.lean 2>&1 | head -40"}