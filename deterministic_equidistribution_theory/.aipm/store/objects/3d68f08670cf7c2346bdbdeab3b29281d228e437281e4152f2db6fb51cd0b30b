{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory/c_suite\n# N=17 row (first aperture). Columns: N,seeds_tested,A,critical_count,max_height,mean_height,tail_H0..H47,runtime\n# tail_count_H0 is column 7. Compute log2(tail_H/seeds) for H=1..14 and successive slope.\nawk -F, '\n  !/^#/ && $1==17 && $3==4 {\n    seeds=$2;\n    printf \"N=17 seeds=%d  mean_h=%s\\n\", seeds, $6;\n    printf \"%3s %12s %10s %8s\\n\",\"H\",\"tail\",\"log2(P)\",\"slope\";\n    prev=\"\";\n    for(H=0;H<=16;H++){\n      c=$(7+H); P=c/seeds;\n      l=(P>0)? log(P)/log(2):-99;\n      s=(prev==\"\")?0:(l-prev);\n      printf \"%3d %12d %10.3f %8.3f\\n\",H,c,l,s;\n      prev=l;\n    }\n  }' out/height_tail.csv"}