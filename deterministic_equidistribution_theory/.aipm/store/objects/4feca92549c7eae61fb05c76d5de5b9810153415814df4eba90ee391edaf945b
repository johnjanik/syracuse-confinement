{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\n\n# CLAIM (exact descent): for chi PRIMITIVE mod 3^c, the nonzero spectrum of the level-c\n# synchronized operator M_chi equals the spectrum of a twisted level-(c-1) operator\n#   N1 g(abar,tau) = chi(A(abar)) sum_b w_b chi(2)^{-b} g(S_b(abar) mod 3^{c-1}, tau+b),\n# where A(abar) = 3*abar+1 evaluated mod 3^c (well-defined since it depends on abar mod 3^{c-1}).\n# Mechanism: states a == a' (mod 3^{c-1}) have IDENTICAL successor sums, so any mu!=0\n# eigenfunction satisfies phi(a,tau) = chi(a) g(a mod 3^{c-1}, tau) EXACTLY.\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef dlog_table(Q):\n    U=units(Q); phi=len(U); d={}; p=1\n    for j in range(phi): d[p]=j; p=(p*2)%Q\n    return d,phi\n\ndef build_M(Q, s, k):\n    \"\"\"level-Q synchronized residue x parity operator, chi_k source twist.\"\"\"\n    U=units(Q); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    dlog,_=dlog_table(Q)\n    q=2.0**(-(1+s)); den=1-q**phi\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/phi) for a in U}\n    n=2*phi; M=np.zeros((n,n),complex)\n    inv={a: pow(a,-1,Q) for a in U}\n    for a in U:\n        t=(3*a+1)%Q\n        for ap in U:\n            b0=dlog[(t*inv[ap])%Q]%phi\n            if b0==0: b0=phi\n            W=(3.0**s)*q**b0/den\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W*chi[a]\n    return M\n\ndef build_N1(Q, s, k):\n    \"\"\"descended operator at level Qm = Q/3, with multiplier chi(A(abar)) and branch phase chi(2)^{-b}.\"\"\"\n    Qm=Q//3\n    U=units(Qm); phim=len(U); idx={a:i for i,a in enumerate(U)}\n    dlogQ,phi=dlog_table(Q)       # chi lives at level Q\n    chi=lambda x: np.exp(2j*np.pi*k*dlogQ[x%Q]/phi)\n    q=2.0**(-(1+s))\n    n=2*phim; M=np.zeros((n,n),complex)\n    # b matters mod lcm(phi,2)=phi for the phase chi(2)^{-b}, and mod phim for residue,\n    # and mod 2 for parity; phi=3*phim, so b mod phi determines everything. Sum geometric tails mod phi.\n    den=1-q**phi\n    zeta=chi(2)**(-1)\n    for abar in U:\n        Aab=(3*abar+1)%Q            # well-defined element of U_Q from abar mod Q/3\n        mult=chi(Aab)\n        for b0 in range(1,phi+1):\n            ap=( (3*abar+1) * pow(pow(2,b0,Qm), -1, Qm) ) % Qm\n            W=(3.0**s)*q**b0/den\n            ph=zeta**b0\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[abar]*2+tau]+=W*mult*ph\n    return M\n\nfor (Q,k,s) in ((81,1,0.0),(81,1,1.0),(243,5,0.0)):\n    M=build_M(Q,s,k); N=build_N1(Q,s,k)\n    eM=np.linalg.eigvals(M); eN=np.linalg.eigvals(N)\n    eM=eM[np.abs(eM)>1e-9]; eMs=np.sort_complex(eM); eNs=np.sort_complex(eN)\n    print(f\"Q={Q} k={k} (primitive) s={s}: dim M={M.shape[0]}, nonzero eigs of M: {len(eM)}, dim N1={N.shape[0]}\")\n    if len(eMs)==len(eNs):\n        d=np.max(np.abs(eMs-eNs))\n        print(f\"   spectra match: max|eig diff| = {d:.2e}   rho(M)={max(abs(eM)):.10f} rho(N1)={max(abs(eN)):.10f}\")\n    else:\n        print(f\"   COUNT MISMATCH: {len(eMs)} vs {len(eNs)}\")\nPY"}