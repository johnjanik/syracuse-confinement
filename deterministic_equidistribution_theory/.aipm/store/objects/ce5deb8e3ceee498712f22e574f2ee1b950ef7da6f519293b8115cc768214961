{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\n# Mode-matrix audit: K[(t1,eps),(t0,eps)] = c_{t0,eps} * J(k - t1, t0),\n#   J(u,v) = (1/phi) sum_{a in U} e_u(a) e_v(3a+1)   (p-adic Jacobi sums)\n# Tests: (1) support/concentration of J rows (stationary phase?), \n#        (2) rho(|K_eps|)/W  -- absolute-value upper bound on gamma_c,\n#        (3) compare with true rho(M_chi)/W.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nfor c,k in ((4,1),(5,1),(6,1),(7,5)):\n    Qc=3**c; phi=2*3**(c-1); q=0.5; W=1.0   # s=0: W = sum 2^-b = 1\n    dlog={}; p=1\n    for j in range(phi): dlog[p]=j; p=(p*2)%Qc\n    U=[pow(2,i,Qc) for i in range(phi)]      # a = 2^i\n    # F_v[i] = e(v*dlog(3*2^i+1)/phi); J(.,v) = FFT_i of F_v\n    dl3=np.array([dlog[(3*a+1)%Qc] for a in U])\n    Jabs=np.zeros((phi,phi))                 # Jabs[u,v]\n    for v in range(phi):\n        F=np.exp(2j*np.pi*v*dl3/phi)\n        J=np.fft.fft(F)/phi                  # J[u] = (1/phi) sum_i F[i] e^{-2pi i u i/phi}? sign conv\n        Jabs[:,v]=np.abs(J)\n    # row concentration stats\n    mass=(Jabs**2).sum(axis=0)               # should be 1 per column (Parseval)\n    thr=1e-8\n    supp=np.array([(Jabs[:,v]>1e-3).sum() for v in range(phi)])\n    print(f\"c={c} k={k}: phi={phi}  Parseval check mean={mass.mean():.6f}  \"\n          f\"J-column support(>1e-3): median={int(np.median(supp))}, max={supp.max()}  \"\n          f\"max|J|={Jabs.max():.4f}  (flat would be ~{phi**-0.5:.4f})\")\n    # |K| spectral radius per parity sector\n    for eps in (0,1):\n        zeta=np.exp(-2j*np.pi*np.arange(phi)/phi)*((-1)**eps)\n        cmag=np.abs(q*zeta/(1-q*zeta))       # |c_{t0,eps}|, W=1\n        # K[t1,t0] = cmag[t0]*Jabs[(k-t1) mod phi, t0]\n        rows=(k-np.arange(phi))%phi\n        Kabs=Jabs[rows,:]*cmag[None,:]\n        # power iteration\n        x=np.ones(phi); \n        for _ in range(300):\n            x=Kabs@x; n=np.linalg.norm(x); x/=n\n        rho=n\n        print(f\"   eps={eps}: rho(|K|)/W = {rho:.4f}\")\nPY"}