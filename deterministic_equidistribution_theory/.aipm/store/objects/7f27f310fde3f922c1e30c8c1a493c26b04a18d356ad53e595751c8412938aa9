]*2+tau] += W * chi[a]\n    return M\n\ndef rho(M): return max(abs(np.linalg.eigvals(M)))\n\nprint(\"=== Theorem A check: residue x parity, full character group, only k=phi/2 peripheral ===\")\nfor Q in (9,27,81):\n    phi = len(units(Q))\n    for s in (0.0,1.0):\n        r0 = rho(build_par(Q,s,0))\n        ratios = {k: rho(build_par(Q,s,k))/r0 for k in range(1,phi//2+1)}\n        peripheral = [k for k,v in ratios.items() if v > 1-1e-9]\n        worst_nc = max((v for k,v in ratios.items() if k != phi//2))\n        print(f\"Q={Q:3d} s={s:.0f}: peripheral k={peripheral} (phi/2={phi//2})  \"\n              f\"max non-cob ratio={worst_nc:.6f}\")\nPY","input_hash":"sha256:bd3f1b8c7c7423b5cb4585d7f1742e578089359f13e097cd4390f8ce891c24a8","output_hash":"sha256:9694359a1c4e5533e85ca15e95e59b229343ab27044f391422b79a45f775bf9f","tool":"Bash"},"time":"2026-06-09T17:55:34Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\nfrom math import gcd\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef build_par(Q, s, kchar):\n    U = units(Q); phi = len(U); idx = {a:i for i,a in enumerate(U)}\n    dlog = {}; p = 1\n    for j in range(phi): dlog[p] = j; p = (p*2) % Q\n    inv = {a: pow(a, -1, Q) for a in U}\n    chi = {a: np.exp(2j*np.pi*kchar*dlog[a]/phi) for a in U}\n    n = 2*phi\n    M = np.zeros((n,n), complex)\n    den = 1.0 - 2.0**(-(1+s)*phi)\n    for a in U:\n        t = (3*a+1) % Q\n        for ap in U:\n            b0 = dlog[(t*inv[ap]) % Q] % phi\n            if b0 == 0: b0 = phi\n            W = (3.0**s) * 2.0**(-(1+s)*b0) / den\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau] += W * chi[a]\n    return M\n\ndef rho(M): return max(abs(np.linalg.eigvals(M)))\n\ndef cond_exp(k, r):\n    \"\"\"conductor exponent c of chi_k at level 3^r: 3^{r-c} || k (k=0 -> c=0).\"\"\"\n    if k == 0: return 0\n    v = 0; kk = k\n    while kk % 3 == 0: kk //= 3; v += 1\n    return r - v\n\nprint(\"=== gamma_c by conductor, residue x parity (collapse check: equal across r) ===\")\nfor s in (0.0, 1.0):\n    print(f\"--- s={s:.0f} ---\")\n    for r,Q in ((2,9),(3,27),(4,81),(5,243)):\n        phi = len(units(Q))\n        r0 = rho(build_par(Q,s,0))\n        byc = {}\n        for k in range(1, phi//2+1):\n            c = cond_exp(k, r)\n            v = rho(build_par(Q,s,k))/r0\n            if c not in byc or v > byc[c][0]: byc[c] = (v,k)\n        out = \"  \".join(f\"c={c}:{byc[c][0]:.6f}(k={byc[c][1]})\" for c in sorted(byc))\n        print(f\"Q={Q:4d}: {out}\")\nPY","input_hash":"sha256:658a9418c10c9b58cf0273298bd6bd1bbf3c36e7890105b7df5fc7dd23f9fc03","output_hash":"sha256:31c1182e87830135cf39dc0b520543293196fe863afce912f5d009ca9a2c263f","tool":"Bash"},"time":"2026-06-09T17:56:10Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 580 python3 - <<'PY'\nimport numpy as np\nfrom math import log2\nLOG23 = log2(3.0)\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef base_and_chars(Q, s, ks):\n    \"\"\"M1 (residue x parity, principal) and the diag multipliers for chi_k, k in ks.\"\"\"\n    U = units(Q); phi = len(U); idx = {a:i for i,a in enumerate(U)}\n    dlog = {}; p = 1\n    for j in range(phi): dlog[p] = j; p = (p*2) % Q\n    inv = {a: pow(a, -1, Q) for a in U}\n    n = 2*phi\n    M1 = np.zeros((n,n))\n    den = 1.0 - 2.0**(-(1+s)*phi)\n    for a in U:\n        t = (3*a+1) % Q\n        for ap in U:\n            b0 = dlog[(t*inv[ap]) % Q] % phi\n            if b0 == 0: b0 = phi\n            W = (3.0**s) * 2.0**(-(1+s)*b0) / den\n            for tau in (0,1):\n                M1[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau] += W\n    # column multiplier per state (depends on a only)\n    D = np.zeros((n, len(ks)), complex)\n    for j,k in enumerate(ks):\n        for a in U:\n            v = np.exp(2j*np.pi*k*dlog[a]/phi)\n            D[idx[a]*2, j] = v; D[idx[a]*2+1, j] = v\n    return M1, D\n\ndef batched_rho(M1, D, iters=400):\n    n, m = D.shape\n    rng = np.random.default_rng(7)\n    V = rng.standard_normal((n,m)) + 1j*rng.standard_normal((n,m))\n    V /= np.linalg.norm(V, axis=0)\n    g = np.zeros(m)\n    for it in range(iters):\n        W = M1 @ (D * V)\n        g = np.linalg.norm(W, axis=0)\n        V = W / g\n    return g\n\nprint(\"=== gamma_c^par sequence, batched (new-conductor chars only) ===\")\nfor s in (0.0, 1.0):\n    row = []\n    for r,Q in ((2,9),(3,27),(4,81),(5,243),(6,729)):\n        phi = len(units(Q))\n        ks = [k for k in range(1, phi//2+1) if k % 3 != 0]   # conductor 3^r chars\n        M1, D = base_and_chars(Q, s, [0])\n        r0 = batched_rho(M1, D, 300)[0]\n        M1, D = base_and_chars(Q, s, ks)\n        g = batched_rho(M1, D, 400)\n        gam = g.max()/r0\n        row.append((r, gam, ks[int(g.argmax())]))\n    print(f\"s={s:.0f}: \" + \"  \".join(f\"g_{r}={v:.6f}(k={k})\" for r,v,k in row))\nPY","input_hash":"sha256:c3ef8bf4e6a862d6d49da74eeb293f6806fda150413c1490df32d406f335c244","output_hash":"sha256:77f3b6167251532a1556725472d878aa602357bdf81617f724ffcabf365b8c7c","tool":"Bash"},"time":"2026-06-09T17:57:37Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\nfrom math import log2\nLOG23 = log2(3.0)\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\n# ---------- 1. Strip rotation identity: spec(L_chi2) = e^{-i pi c*/R} spec(L_1) ----------\ndef build_strip(Q, s, quad, L, R, Bmax=60):\n    U = units(Q); idx = {a:i for i,a in enumerate(U)}\n    cstar = round(R*LOG23)\n    n = len(U)*(L+1)\n    M = np.zeros((n,n), complex)\n    for a in U:\n        chi = 1.0\n        if quad: chi = 1.0 if a % 3 == 1 else -1.0\n        t = (3*a+1) % Q\n        for b in range(1, Bmax+1):\n            ap = (t * pow(pow(2,b,Q), -1, Q)) % Q\n            dz = cstar - R*b\n            w = (3.0**s) * 2.0**(-(1+s)*b)\n            for z in range(L+1):\n                zp = z+dz\n                if 0 <= zp <= L:\n                    M[idx[ap]*(L+1)+zp, idx[a]*(L+1)+z] += w*chi\n    return M, cstar\n\nQ,s,L,R = 9, 0.0, 12, 2\nM1,cstar = build_strip(Q,s,False,L,R)\nM2,_     = build_strip(Q,s,True ,L,R)\ne1 = np.sort_complex(np.linalg.eigvals(M1))\ne2 = np.sort_complex(np.linalg.eigvals(M2))\nlam = np.exp(-1j*np.pi*cstar/R)\ne1r = np.sort_complex(lam*e1)\n# compare multisets\nd = np.max(np.abs(np.sort(e2.view(float)) - np.sort(e1r.view(float))))\nprint(f\"strip rotation: Q={Q} L={L} R={R} c*={cstar}: max|spec(L_chi2) - e^(-i pi c*/R) spec(L_1)| = {d:.2e}\")\n\n# ---------- 2. Functional equation brute force: psi(3a+1) = lam' psi(a) chi(a) on U ----------\nprint(\"\\n=== product-form strip coboundary candidates: psi(3a+1)=lam' psi(a) chi(a), all a in U ===\")\nfor r in (2,3,4):\n    Q = 3**r; U = units(Q); phi = len(U)\n    dlog = {}; p=1\n    for j in range(phi): dlog[p]=j; p=(p*2)%Q\n    sols = []\n    for u in range(phi):          # psi = chi_u\n        for w in range(phi):      # chi = chi_w\n            # lam' from a=1: psi(4) = lam' (psi(1)chi(1)=1)\n            lamp = np.exp(2j*np.pi*u*dlog[4 % Q]/phi)\n            ok = True\n            for a in U:\n                lhs = np.exp(2j*np.pi*u*dlog[(3*a+1)%Q]/phi)\n                rhs = lamp*np.exp(2j*np.pi*(u*dlog[a]+w*dlog[a])/phi) if False else \\\n                      lamp*np.exp(2j*np.pi*u*dlog[a]/phi)*np.exp(2j*np.pi*w*dlog[a]/phi)\n                if abs(lhs-rhs) > 1e-9: ok=False; break\n            if ok: sols.append((u,w))\n    quad = phi//2\n    print(f\"r={r} (Q={Q}, phi={phi}): solutions (psi_index u, chi_index w) = {sols}\"\n          f\"   [w=0 trivial, w={quad} = chi_2]\")\nPY","input_hash":"sha256:9bfa49b5fa826e346534aaad47d661a75163a0de26f14b4dec6c149b98bd7440","output_hash":"sha256:fae817dd2cb0cb6121b447a7560f3bb9044e9b02d816ea162665049de55923ee","tool":"Bash"},"time":"2026-06-09T17:58:01Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ngrep -n \"section{Conductor autonomy}\\|section{The quadratic coboundary\\|begin{conjecture}\\|end{conjecture}\\|Proof status\\|part{The refined\\|part{Numerical evidence\" finite_spectral_shadows.tex","input_hash":"sha256:aed16682e29a288a04f3451affccc0737687ca1c5d9f4d06d8523ef87f32f54c","output_hash":"sha256:7546c232b511a17a093b8c930274c1c1f8530094d84f336f2fb7dc77e0bab9b0","tool":"Bash"},"time":"2026-06-09T17:58:57Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"file_read","materiality_hint":null,"target":{"input_hash":"sha256:8b4f1c46590ac15fc9992bd87d2e35701142b9169e45c04a8fb8db22f85d4e8f","output_hash":"sha256:6d677a1674525ee4b2171d627f0d6a2b0899009fd4a7f529028f18da861a8217","path":"/home/john/mynotes/deterministic_equidistribution_theory/finite_spectral_shadows.tex","tool":"Read"},"time":"2026-06-09T17:59:03Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"file_edited","materiality_hint":{"possible_claim_effect":true,"possible_code_effect":true},"target":{"after_hash":"sha256:33e46823d2af6e677ca362591f2c7796a6e17fbe69a0a60cbbb350915977d1cc","input_hash":"sha256:2e444e2475c81bf1f66e040507fa3c6114d6a067780471141cab7f5e789cdeec","output_hash":"sha256:d07cf18a398f47890a6a756ddff90cda8e4bc4ff25a4660e91b6c54446c14b31","path":"/home/john/mynotes/deterministic_equidistribution_theory/finite_spectral_shadows.tex","tool":"Edit"},"time":"2026-06-09T17:59:38Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"file_ed