{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\n# E_hat_L(u) = E_w[e(u C_w / 3^L)], words of length L, p(b)=2^{-b}.\n# Forward recursion over the cyclic group <2> mod 3^L (index B mod P, P=2*3^{L-1}).\ndef Ehat(L, us):\n    Q=3**L; P=2*3**(L-1)\n    pw=np.array([pow(2,r,Q) for r in range(P)],np.int64)  # 2^B for B mod P (B=0..P-1)\n    G=np.array([2.0**(-(d if d>0 else P))/(1-2.0**(-P)) for d in range(P)])  # geometric increments mod P\n    fG=np.fft.fft(G)\n    out={}\n    for u in us:\n        a=np.zeros(P,complex); a[0]=1.0\n        for j in range(L):\n            ph=np.exp(2j*np.pi*((u*pow(3,L-1-j,Q)%Q)*pw%Q)/Q)\n            a=np.fft.ifft(np.fft.fft(a*ph)*fG)\n        out[u]=abs(a.sum())\n    return out\nrng=np.random.default_rng(3)\nprint(f\"{'L':>2} {'max|E|(sample)':>14} {'3^{L/2}*max':>11} {'argmax-u':>9} {'sum_u|E|^2 (small L exact)':>20}\")\nfor L in range(3,9):\n    Q=3**L\n    us=[u for u in range(1,min(Q,120)) if u%3]+ [int(x) for x in rng.integers(1,Q,150) if x%3]\n    us=sorted(set(us))\n    E=Ehat(L,us)\n    mx=max(E.values()); am=max(E,key=E.get)\n    tot=\"\"\n    if L<=6:\n        allu=[u for u in range(1,Q) if u%3]\n        EE=Ehat(L,allu)\n        # add imprimitive levels: full sum over ALL u mod 3^L = 1 + sum over levels\n        s=1.0\n        for ell in range(L):\n            lev=[u*3**ell for u in range(1,3**(L-ell)) if u%3]\n            El=Ehat(L,[v for v in lev]) if ell>0 else EE\n            s+=sum(v*v for v in El.values())\n        tot=f\"{s:.3f}\"\n    print(f\"{L:>2} {mx:>14.5f} {mx*3**(L/2):>11.3f} {am:>9} {tot:>20}\")\nPY"}