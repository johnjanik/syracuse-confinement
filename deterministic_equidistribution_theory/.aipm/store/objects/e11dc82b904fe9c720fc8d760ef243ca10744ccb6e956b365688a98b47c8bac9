{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory/c_suite/out_large\necho \"### E: min gap_ratio per (Q,s) — is there a gap, does kappa_Q hold as Q grows? ###\"\nawk -F, '!/^#/ && $1!=\"Q\" && $6!=\"trivial\" {key=$1\"|\"$5; gr=$10; if(!(key in mn)||gr<mn[key])mn[key]=gr}\n  END{ printf \"%6s %6s %12s %12s\\n\",\"Q\",\"s\",\"min_gap_ratio\",\"kappa=1-gr\"; \n       n=asorti(mn,idx); for(i=1;i<=n;i++){split(idx[i],a,\"|\"); printf \"%6s %6s %12.4f %12.4f\\n\",a[1],a[2],mn[idx[i]],1-mn[idx[i]]}}' spectral_gaps.csv\necho \"### F: exact vs annealed Fourier — correlation & mean |deviation| ###\"\nawk -F, '!/^#/ && $1!=\"Q\" {n++; d+=($7<0?-$7:$7); \n   ea+=$5*$4; e2+=$5*$5; a2+=$4*$4; se+=$5; sa+=$4}\n  END{ if(n){mc=(n*ea-se*sa)/sqrt((n*e2-se*se)*(n*a2-sa*sa)); \n       printf \"rows=%d  mean|exact_s0 - annealed|=%.4f  corr(exact_s0,annealed)=%.3f\\n\",n,d/n,mc}}' fourier_comparison.csv\nawk -F, '!/^#/ && $1!=\"Q\"{print}' fourier_comparison.csv | sort -t, -k1,1n -k2,2n | awk -F, '{printf \"Q=%s k=%-2s xi=%.4f ann=%.4f exact_s0=%.4f exact_s1=%.4f dev=%+.4f\\n\",$1,$2,$3,$4,$5,$6,$7}' | head -8\necho \"### I: shadow rate by label & by length (1.25M windows) ###\"\nawk -F, '!/^#/ && $1!=\"window_id\" && NF>=14 {n[$5]++; if($14==1)s[$5]++}\n  END{for(l in n) printf \"  %-22s n=%-8d frac_shadow=%.4f\\n\",l,n[l],s[l]/n[l]}' shadow_search.csv\nawk -F, '!/^#/ && $1!=\"window_id\" && NF>=14 {L=$4; b=(L<16)?\"008-015\":(L<32)?\"016-031\":(L<64)?\"032-063\":(L<128)?\"064-127\":\"128+\"; n[b]++; if($14==1)s[b]++}\n  END{for(x in n) printf \"  len %-8s n=%-8d frac_shadow=%.4f\\n\",x,n[x],s[x]/n[x]}' shadow_search.csv | sort"}