{"command":"cd /home/john/mynotes/shadow_frontier\ntimeout 560 python3 - <<'PY'\nimport numpy as np, math\nLOG23=math.log2(3.0); LN2=math.log(2.0)\nz=np.exp(2j*np.pi/3)\nG=sum(2.0**-b*z**-b for b in range(1,200))\ndef lamT(D, grid=0.01, bmax=20, t=0.0, omega=1.0):\n    xs=np.arange(-D,D+1e-9,grid); n=len(xs)\n    T=np.zeros((n,n))\n    for b in range(1,bmax+1):\n        w=math.exp(t*float(np.real(omega*(z**(-b)-G))))\n        shift=LOG23-b\n        for i,s in enumerate(xs):\n            s2=s+shift\n            if -D-1e-9<=s2<=D+1e-9:\n                j=int(round((s2+D)/grid))\n                if 0<=j<n: T[j,i]+=w\n    v=np.ones(n)\n    for _ in range(800):\n        v=T@v; nv=np.linalg.norm(v); v/=nv\n    return nv\n# refine D*\nprint(\"refining D* (lambda(D)=2):\")\nlo,hi=1.0,1.5\nfor _ in range(12):\n    mid=(lo+hi)/2\n    if lamT(mid)>2: hi=mid\n    else: lo=mid\nprint(f\"  D* = {(lo+hi)/2:.3f}  (band ratio W* = 2^(2D*) = {2**(2*(lo+hi)/2):.2f})\")\n# biased rate at D=3: parametric (bias, rate) curve via tilting\nprint(\"\\nbiased strip rate at D=3 (tilt parametric):\")\nD=3.0\nfor omega_ang in (0.0,):\n    om=np.exp(1j*omega_ang)\n    prev=None\n    print(f\"{'t':>5} {'lambda_t':>9} {'bias(t)':>8} {'eff rate ln':>11} {'theta_eff':>9}\")\n    for t in (0,2,4,6,8,10,14,18):\n        lt=lamT(D,t=t,omega=om)\n        dt=0.25\n        lt2=lamT(D,t=t+dt,omega=om)\n        biast=(math.log(lt2)-math.log(lt))/dt   # d ln lambda / dt = achieved bias\n        rate=math.log(lt)-t*biast               # Legendre: entropy rate at that bias\n        print(f\"{t:>5} {lt:>9.4f} {biast:>8.4f} {rate:>11.4f} {rate/LN2:>9.3f}\")\nPY"}