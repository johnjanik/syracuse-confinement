{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 300 python3 - <<'PY'\nimport random\nrandom.seed(5)\n# CLAIM 1: the set {x odd: first p valuation letters = u} is ONE residue class mod 2^{B_u+1}:\n# equivalently, same p-block => x = x' mod 2^{B_u+1}.\ndef word_of(x,p):\n    w=[]\n    for _ in range(p):\n        y=3*x+1;b=0\n        while y%2==0:y//=2;b+=1\n        w.append(b);x=y\n    return tuple(w)\nfails=0;checks=0\nfor trial in range(3000):\n    p=random.randint(3,10)\n    x=random.randrange(1,10**6)*2+1\n    u=word_of(x,p); B=sum(u)\n    # another point in the same class:\n    t=random.randrange(1,1000)\n    x2=x+t*(1<<(B+1))\n    checks+=1\n    if word_of(x2,p)!=u: fails+=1\n    # and a point in a different class with same parity should generically differ:\nimport numpy as np\nprint(f\"CLAIM 1 (same class => same block): {checks} checks, {fails} failures\")\n# converse: same block => congruent mod 2^{B+1}\nfails2=0;checks2=0\nseen={}\nfor x in range(1,200001,2):\n    u=word_of(x,6)\n    if u in seen:\n        B=sum(u)\n        if (x-seen[u])%(1<<(B+1))!=0: fails2+=1\n        checks2+=1\n    else: seen[u]=x\nprint(f\"CLAIM 1b (same block => congruent mod 2^(B+1)): {checks2} checks, {fails2} failures\")\n# CLAIM 2: Sturmian discrepancy bounded: Theta_N = N*log2(3) - B_N, |Theta| <= 1+eps\nfrom math import log2\nALPHA=2-log2(3)\nfor theta in (0.0,0.31,0.77):\n    bs=[1 if ((n*ALPHA+theta)%1.0)<ALPHA else 2 for n in range(100000)]\n    Th=[ (n+1)*log2(3)-sum(bs[:n+1]) for n in range(0,100000,997)]\n    import numpy as np\n    print(f\"CLAIM 2 (Sturmian discrepancy, theta={theta}): max|Theta| over samples = {max(abs(t) for t in Th):.3f}\")\nPY"}