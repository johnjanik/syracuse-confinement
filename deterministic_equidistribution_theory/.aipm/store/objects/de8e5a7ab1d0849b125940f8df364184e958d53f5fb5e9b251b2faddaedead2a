{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 590 python3 - <<'PY'\nimport numpy as np\nc,k=7,1\nQc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\ndlog={}; p=1\nfor j in range(PHI): dlog[p]=j; p=(p*2)%Qc\nU=[a for a in range(Qc) if a%3!=0]; phi=len(U); idx={a:i for i,a in enumerate(U)}\ninv={a:pow(a,-1,Qc) for a in U}\nchiv=np.exp(2j*np.pi*k*np.array([dlog[a] for a in U])/PHI)\nT=np.zeros((2*phi,2*phi),complex)\nfor ai,a in enumerate(U):\n    t3=(3*a+1)%Qc\n    for ap in U:\n        b0=dlog[(t3*inv[ap])%Qc]%PHI\n        if b0==0: b0=PHI\n        W0=q**b0/den\n        for tau in (0,1):\n            T[idx[ap]*2+(tau+b0)%2, ai*2+tau]+=W0*chiv[ai]\nprint(f\"c={c}: dim={2*phi}\")\nD0=1/3.0  # Delta_0 at s=0\nfor m in (c, c+2, 2*c):\n    Tm=np.linalg.matrix_power(T,m)\n    H=Tm.conj().T@Tm\n    R=np.abs(H).sum(axis=0).max()\n    # sigma1 via power iteration on Hermitian H\n    v=np.random.default_rng(7).standard_normal(2*phi)+0j; v/=np.linalg.norm(v)\n    for _ in range(300):\n        v=H@v; n=np.linalg.norm(v); v/=n\n    s1=np.sqrt(n)\n    Am=R/(D0**m)\n    print(f\"  m={m:2d}: sigma1^(1/m)={s1**(1/m):.4f}  Schur R^(1/2m)={R**(1/(2*m)):.4f}  \"\n          f\"A_m=R/Delta^m={Am:.3e}  A^(1/2m)={Am**(1/(2*m)):.4f}\")\nPY"}