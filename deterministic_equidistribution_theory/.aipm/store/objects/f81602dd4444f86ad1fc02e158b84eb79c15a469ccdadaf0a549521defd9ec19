{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory/c_suite/out_large\nawk -F, '\n  # F residue-only gaps: Q,k -> gap_s0(col5), gap_s1(col6)\n  FNR==NR { if(!/^#/ && $1!=\"Q\") { g0[$1\",\"$2]=$5; g1[$1\",\"$2]=$6 } ; next }\n  !/^#/ && $1!=\"window_id\" && NF>=14 && $14==1 {\n    Q=$7; k=$8; s=$9; W=$6; L=$4;\n    # tilt distribution of shadows\n    sc[s]++; if(L>=64) lsc[s]++;\n    # Q distribution\n    qc[Q]++;\n    # join gap at this tilt\n    key=Q\",\"k; gap=-1;\n    if(s==\"1.0000\") gap=g1[key]; else if(s==\"0.0000\") gap=g0[key];\n    if(gap>=0){ n++; sx+=W; sy+=gap; sxy+=W*gap; sx2+=W*W; sy2+=gap*gap;\n                if(L>=64){ ln++; lsy+=gap } }\n  }\n  END{\n    print \"=== shadow argmax TILT distribution ===\";\n    for(x in sc) printf \"  s=%-7s  shadows=%-8d  long(>=64)=%d\\n\",x,sc[x],lsc[x]+0;\n    print \"=== shadow argmax MODULUS distribution ===\";\n    for(x in qc) printf \"  Q=%-4s  shadows=%d\\n\",x,qc[x];\n    print \"=== |W| vs operator gap_ratio (argmax sector, s in {0,1}) ===\";\n    if(n){ corr=(n*sxy-sx*sy)/sqrt((n*sx2-sx*sx)*(n*sy2-sy*sy));\n      printf \"  n=%d  mean|W|=%.4f  mean gap_ratio=%.4f  corr(|W|,gap)=%.3f\\n\",n,sx/n,sy/n,corr;\n      printf \"  long windows(>=64): n=%d  mean gap_ratio=%.4f\\n\",ln,ln?lsy/ln:0 }\n  }' fourier_comparison.csv shadow_search.csv | sort"}