nt=False):\n        h,_=solve(eps,np.exp(1j*ang))\n        if not np.isnan(h): best=max(best,h)\n    print(f\"{eps:>6.2f} {best:>8.4f} {best/LN2:>11.3f}\")\nPY\ntimeout 400 python3 search/entropy_bias.py","input_hash":"sha256:13f3c2e3599be822a0f4879c0e47dac0a9d73b324bd194ae4dacbc84ff85b053","output_hash":"sha256:1ae918becf8b196d2c676707c5b4eb00c15823fe2c75b6ea42c351e39d58dc67","tool":"Bash"},"time":"2026-06-10T14:06:34Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/shadow_frontier\ncat > search/strip_rate.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Growth rate lambda(D) of valuation words with discrepancy |B_j - j*log2(3)| <= D\nconfined to a strip, via transfer matrix on a discretized strip. theta(D)=ln lambda/ln 2:\ntheta < 1 => banded windows of half-width D force repetition before filling the band.\"\"\"\nimport numpy as np, math\nLOG23=math.log2(3.0); LN2=math.log(2.0)\ndef lam(D, grid=0.02, bmax=18, bias_eps=0.0):\n    xs=np.arange(-D,D+1e-9,grid); n=len(xs)\n    T=np.zeros((n,n))\n    for i,s in enumerate(xs):\n        for b in range(1,bmax+1):\n            s2=s+LOG23-b\n            if -D-1e-9<=s2<=D+1e-9:\n                j=int(round((s2+D)/grid))\n                if 0<=j<n: T[j,i]+=1.0\n    # power iteration\n    v=np.ones(n)\n    for _ in range(600):\n        v=T@v; nv=np.linalg.norm(v)\n        if nv==0: return 0.0\n        v/=nv\n    return float(nv)\nprint(f\"{'D':>5} {'lambda(D)':>10} {'theta=ln l/ln2':>14}   (theta<1: narrow-band squeeze ACTIVE)\")\nfor D in (0.5,0.8,1.0,1.5,2.0,3.0,4.0,6.0,9.0,13.0):\n    l=lam(D)\n    print(f\"{D:>5.1f} {l:>10.4f} {math.log(l)/LN2 if l>0 else float('nan'):>14.3f}\")\nPY\ntimeout 560 python3 search/strip_rate.py","input_hash":"sha256:3067eba49290666b69fe850eea5ad0efbde20a11938fe729680919000f2e8b38","output_hash":"sha256:053fe8ef00cd0029050be8e999cc18a04086baddc925467a6548c45abdc9b1fc","tool":"Bash"