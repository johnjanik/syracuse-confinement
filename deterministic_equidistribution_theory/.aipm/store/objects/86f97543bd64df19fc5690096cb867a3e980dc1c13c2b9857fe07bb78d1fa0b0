{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\ndef build_T(c,k):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=[a for a in range(Qc) if a%3]; phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chiv=np.exp(2j*np.pi*k*np.array([dlog[a] for a in U])/PHI)\n    T=np.zeros((2*phi,2*phi),complex)\n    for ai,a in enumerate(U):\n        t3=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t3*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, ai*2+tau]+=W0*chiv[ai]\n    return T\nprint(f\"{'c':>2} {'m':>3} {'sigma1^(1/m)':>12} {'R_H^(1/2m)':>11} {'R_G^(1/2m)':>11}\")\nfor c in (4,5,6,7):\n    T=build_T(c,1); m=c\n    Tm=np.linalg.matrix_power(T,m)\n    H=Tm.conj().T@Tm; G=Tm@Tm.conj().T\n    RH=np.abs(H).sum(axis=0).max(); RG=np.abs(G).sum(axis=0).max()\n    s1=np.linalg.norm(Tm,2)\n    print(f\"{c:>2} {m:>3} {s1**(1/m):>12.4f} {RH**(1/(2*m)):>11.4f} {RG**(1/(2*m)):>11.4f}\")\nPY"}