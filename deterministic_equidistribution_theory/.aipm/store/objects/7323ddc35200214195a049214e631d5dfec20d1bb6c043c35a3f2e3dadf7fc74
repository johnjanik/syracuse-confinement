{"command":"cd /home/john/mynotes/shadow_frontier && python3 - <<'PY'\nimport math\ndef v2(n):\n    n=abs(n); return (n & -n).bit_length()-1\ndef step(x):\n    t=3*x+1; b=v2(t); return t>>b, b\ndef chain_n(n, maxr=40):\n    # minus family with parameter n: x = 2^(n+1) * 3^0 - 1 (g=n+1, a=0)\n    x = 2**(n+1) - 1\n    rounds, readings = 0, []\n    while rounds < maxr:\n        g=v2(x+1); l=g-1; m=(x+1)>>g\n        v=v2(3**l*m-1); readings.append(v)\n        if v%2==1: return rounds, readings\n        for _ in range(l+v//2): x,_=step(x)\n        rounds+=1\n    return rounds, readings\n\nNMAX=3000\nhist={}; champ=(0,None,None)\nsurv=[0]*9\nfor n in range(1,NMAX+1):\n    r,rd=chain_n(n)\n    hist[r]=hist.get(r,0)+1\n    for j in range(r+1): \n        if j<9: surv[j]+=1\n    if r>champ[0]: champ=(r,n,rd)\ntot=NMAX\nprint(f\"minus-family cascade per n (n <= {NMAX}):\")\nprev=tot\nfor j in range(0,8):\n    s=surv[j+1] if j+1<9 else 0\n    print(f\"  survive >= {j+1} rounds: {surv[j+1] if j+1<9 else 0:5d}/{tot} = {s/tot:.5f}\"\n          f\"   conditional next-round survival: {s/prev:.3f}\" if prev else \"\")\n    prev=s if s else prev\n    if s==0: break\nprint(f\"  round-1 survival prediction (LTE law, v2(n) even >= 2): 1/6 = {1/6:.5f}\")\nprint(f\"  champion: n={champ[1]} survives {champ[0]} rounds, readings={champ[2]}\")\n# all n surviving >= 4 rounds\ndeep=[(n,)+chain_n(n) for n in range(1,NMAX+1)]\ndeep=[(n,r,rd) for n,r,rd in deep if r>=4]\nprint(f\"  n surviving >= 4 rounds ({len(deep)}):\")\nfor n,r,rd in deep[:12]: print(f\"    n={n}: {r} rounds, readings {rd}\")\nPY","description":"Per-n cascade statistics for minus family","timeout":900000}