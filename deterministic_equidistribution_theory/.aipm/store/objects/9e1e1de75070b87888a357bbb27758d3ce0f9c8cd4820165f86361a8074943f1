{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\n# Verify the key identity chi2(S(x)) = (-1)^{v2(3x+1)} for the quadratic character mod 3^r.\n# chi2(a) = +1 if a is a QR mod 3^r else -1 ; for units, QR <=> a ≡ 1 (mod 3) (Lemma A).\ndef v2(n):\n    k=0\n    while n%2==0: n//=2; k+=1\n    return k\ndef S(x):\n    y=3*x+1; b=v2(y); return y//(2**b), b\ndef is_unit(a,Q): \n    return a%3!=0\ndef chi2_via_mod3(a):           # Lemma A: chi2(a) depends only on a mod 3\n    r=a%3\n    return 1 if r==1 else (-1 if r==2 else 0)\ndef chi2_via_QR(a,Q):           # independent definition: actual quadratic residue test mod Q\n    if a%3==0: return 0\n    a%=Q\n    squares=set((t*t)%Q for t in range(1,Q) if t%3!=0)\n    return 1 if a in squares else -1\n\nimport random\nok=True\n# (1) confirm Lemma A: chi2 via mod-3 == chi2 via genuine QR test, all units, r=1..6\nfor r in range(1,7):\n    Q=3**r\n    for a in range(1,Q):\n        if a%3==0: continue\n        if chi2_via_mod3(a)!=chi2_via_QR(a,Q): ok=False; print(\"LemmaA FAIL\",r,a)\nprint(\"Lemma A (chi2 = legendre mod 3 = genuine QR mod 3^r):\", \"OK\" if ok else \"FAIL\")\n\n# (2) confirm key identity chi2(S(x)) = (-1)^{v2(3x+1)} over many odd x, several r\nbad=0; tot=0\nfor x in range(1, 200001, 2):\n    sx,b=S(x)\n    lhs=chi2_via_mod3(sx)           # S(x) is always a unit (3x+1 ≡ 1 mod 3)\n    rhs=(-1)**b\n    tot+=1\n    if lhs!=rhs: bad+=1\nprint(f\"Key identity chi2(S(x))=(-1)^b: {tot-bad}/{tot} match\")\n\n# (3) confirm running product: prod_{i=1..n} chi2(x_i) = (-1)^{B_n}\ndef orbit_check(x0, steps=200):\n    x=x0; prod=1; B=0\n    for i in range(steps):\n        x,b=S(x); B+=b; prod*=chi2_via_mod3(x)\n        if prod!=(-1)**B: return False\n        if x==1: break\n    return True\nallok=all(orbit_check(x) for x in range(1,5000,2))\nprint(\"Running product prod chi2(x_i) = (-1)^{B_n}:\", \"OK\" if allok else \"FAIL\")\nPY"}