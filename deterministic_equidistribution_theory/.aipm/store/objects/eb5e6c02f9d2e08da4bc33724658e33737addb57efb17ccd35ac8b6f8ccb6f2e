{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\ndef dlog_table(Q):\n    U=units(Q); phi=len(U); d={}; p=1\n    for j in range(phi): d[p]=j; p=(p*2)%Q\n    return d,phi\ndef build_M(Q,s,k):\n    U=units(Q); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    dlog,_=dlog_table(Q); q=2.0**(-(1+s)); den=1-q**phi\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/phi) for a in U}\n    inv={a: pow(a,-1,Q) for a in U}\n    M=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t=(3*a+1)%Q\n        for ap in U:\n            b0=dlog[(t*inv[ap])%Q]%phi\n            if b0==0: b0=phi\n            W=(3.0**s)*q**b0/den\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W*chi[a]\n    return M\ndef build_N1(Q,s,k):\n    Qm=Q//3; U=units(Qm); phim=len(U); idx={a:i for i,a in enumerate(U)}\n    dlogQ,phi=dlog_table(Q); chi=lambda x: np.exp(2j*np.pi*k*dlogQ[x%Q]/phi)\n    q=2.0**(-(1+s)); den=1-q**phi; zeta=chi(2)**(-1)\n    M=np.zeros((2*phim,2*phim),complex)\n    for abar in U:\n        mult=chi((3*abar+1)%Q)\n        for b0 in range(1,phi+1):\n            ap=((3*abar+1)*pow(pow(2,b0,Qm),-1,Qm))%Qm\n            W=(3.0**s)*q**b0/den\n            for tau in (0,1):\n                M[idx[ap]*2+(tau+b0)%2, idx[abar]*2+tau]+=W*mult*zeta**b0\n    return M\n\nfor (Q,k,s) in ((81,1,0.0),(81,1,1.0),(243,5,0.0)):\n    eM=np.linalg.eigvals(build_M(Q,s,k)); eN=np.linalg.eigvals(build_N1(Q,s,k))\n    mags=np.sort(np.abs(eM))[::-1]\n    nN=len(eN)\n    print(f\"Q={Q} k={k} s={s}: |eig(M)| ranked: top={mags[0]:.8f}  \"\n          f\"#{nN}th={mags[nN-1]:.2e}  #{nN+1}th={mags[nN]:.2e}  (gap = nilpotent ring?)\")\n    # match the top nN eigenvalues of M against spec(N1)\n    eMtop=eM[np.argsort(-np.abs(eM))][:nN]\n    used=np.zeros(nN,bool); maxd=0\n    for lam in eMtop:\n        d=np.abs(eN-lam); d[used]=9e9; j=int(d.argmin()); used[j]=True\n        maxd=max(maxd,d[j] if d[j]<9e9 else 9e9)\n    print(f\"   greedy match of top {nN} eigs of M to spec(N1): max|diff| = {maxd:.2e}\"\n          f\"   rho(M)={np.abs(eM).max():.10f}  rho(N1)={np.abs(eN).max():.10f}\")\nPY"}