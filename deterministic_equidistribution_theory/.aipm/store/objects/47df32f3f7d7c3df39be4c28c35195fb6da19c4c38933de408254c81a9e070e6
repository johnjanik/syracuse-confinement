{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory/c_suite/out_large\necho \"### E: trivial rho0 and min gap_ratio per (Q,s) ###\"\necho \"Q,s,rho0,min_gap_ratio,kappa_Q(=1-min_ratio)\"\ngrep -v '^#' spectral_gaps.csv | grep -v '^Q,L' | awk -F, '\n  $6==\"trivial\"{rho0[$1\"|\"$5]=$8}\n  $6!=\"trivial\"{k=$1\"|\"$5; gr=$10; if(!(k in mn)||gr<mn[k])mn[k]=gr}\n  END{ for(k in mn){split(k,a,\"|\"); printf \"%s,%s,%.4f,%.4f,%.4f\\n\",a[1],a[2],rho0[k],mn[k],1-mn[k]}}' | sort -t, -k1,1n -k2,2n\necho\necho \"### E: does the gap kappa_Q shrink as Q grows? (min over chars, per s) ###\"\ngrep -v '^#' spectral_gaps.csv | grep -v '^Q,L' | awk -F, '\n  $6!=\"trivial\" && $5==\"1.0000\"{k=$1; gr=$10; if(!(k in mn)||gr<mn[k])mn[k]=gr}\n  END{print \"at s=1:\"; for(q in mn) printf \"  Q=%-4s kappa_Q=%.4f\\n\",q,1-mn[q]}' | sort -t= -k2 -n"}