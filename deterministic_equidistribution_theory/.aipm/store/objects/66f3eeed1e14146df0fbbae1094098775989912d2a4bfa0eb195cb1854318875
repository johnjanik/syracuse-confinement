{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\n\n# Mode-damping lemma check: M_chi(eta (x) eps) = c_{eta,eps} * (chi*(eta o A)) (x) eps\n# with c_{eta,eps} = sum_b w_b zeta^b,  zeta = eta(2)^{-1} (-1)^eps,  w_b = 3^s q^b, q=2^{-(1+s)}.\n# Claim: |c|/W = (1-q)/|1-q zeta|, equality iff zeta=1 iff (eta,eps) in {(1,0),(chi2,1)}.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\n\nfor (Q,s) in ((27,0.0),(27,1.0),(81,0.5)):\n    U=units(Q); phi=len(U)\n    q = 2.0**(-(1+s)); W = (3.0**s)*q/(1-q)\n    # numerically: apply Koopman M_1-with-mode to eta(x)eps and read the coefficient\n    dlog={}; p=1\n    for j in range(phi): dlog[p]=j; p=(p*2)%Q\n    ok=True\n    for k in (0,1,phi//2,phi//3,5%phi):\n        for eps in (0,1):\n            zeta = np.exp(-2j*np.pi*k/phi) * (-1)**eps\n            pred = (3.0**s)*q*abs(zeta)/abs(1-q*zeta)   # |c|\n            # direct: c = sum_b w_b eta(2)^{-b} (-1)^{eps b}, truncate\n            c = sum((3.0**s)*q**b * np.exp(-2j*np.pi*k*b/phi) * (-1)**(eps*b) for b in range(1,400))\n            if abs(abs(c)-pred) > 1e-10: ok=False; print(\"MISMATCH\",Q,s,k,eps)\n            if k in (0,phi//2):\n                tag = \"UNDAMPED\" if abs(abs(c)/W-1)<1e-12 else f\"damped {abs(c)/W:.4f}\"\n                print(f\"  Q={Q} s={s} k={k:2d} eps={eps}: |c|/W = {abs(c)/W:.6f}  [{tag}]\")\n    print(f\"Q={Q} s={s}: formula |c| = 3^s q/|1-q zeta| verified: {ok}\")\n\nprint()\nprint(\"=== damping angle scaling: worst (smallest) damping among conductor-3^c primitive modes ===\")\nfor s in (0.0,1.0):\n    q = 2.0**(-(1+s))\n    for c in (2,4,6,8):\n        phi = 2*3**(c-1)\n        # primitive: k coprime to 3 -> smallest |angle| of zeta over eps: theta = 2 pi k/phi (+pi for eps=1)\n        th = 2*np.pi/phi   # k=1, eps=0 is the least-damped non-coboundary mode\n        ratio = (1-q)/np.sqrt(1-2*q*np.cos(th)+q*q)\n        print(f\"  s={s:.0f} c={c}: least one-step mode damping (1-ratio) = {1-ratio:.3e}  (~ angle^2 ~ 9^-c)\")\nPY"}