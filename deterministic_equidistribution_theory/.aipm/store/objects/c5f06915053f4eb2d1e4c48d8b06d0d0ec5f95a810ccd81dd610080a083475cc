 sig=(1,2) if random.random()<.5 else (1,1,2)\n    l,K,C,D=sig_data(sig)\n    Lp=random.randint(8,14)\n    A=random.randrange(1,1<<30)|1\n    beta=align(A,C,D)\n    gam=random.randint(0,max(0,beta))         # gamma <= beta\n    B=(random.randrange(1,1<<20)|1)<<gam\n    t=random.randint(gam+1,gam+6)\n    cnt=sum(1 for u in range(1<<Lp) if align(A+B*u,C,D)>=t)\n    pred=2**(Lp-t+gam) if Lp-t+gam>=0 else 0\n    if cnt!=pred: ok=False; cex=(sig,beta,gam,t,cnt,pred)\nprint(f\"  400 cases with gamma<=beta: {ok}\", cex if cex else \"\")\n# show the beta<gamma failure mode explicitly\nsig=(1,2); l,K,C,D=sig_data(sig)\nA=11; beta=align(A,C,D); B=2**(beta+3); t=beta+1\ncnt=sum(1 for u in range(1<<10) if align(A+B*u,C,D)>=t)\nprint(f\"  beta<gamma counterexample: beta={beta} gamma={beta+3} t={t}: count={cnt}, naive formula predicts {2**(10-t+beta)}\")\n\nprint(\"=== V7 refined: ride-aware visits (maximal consecutive blocks) ===\")\nfor sig in [(1,2),(1,1,2),(2,1)]:\n    l,K,C,D=sig_data(sig)\n    exit_gaps=[]; quick=0; total=0\n    for _ in range(400):\n        x=random.randrange(1<<48,1<<52)|1\n        xs=[]; y=x\n        for _ in range(4000):\n            if y==1: break\n            xs.append(y); y,_=step(y)\n        t=0\n        last_exit=None\n        while t<len(xs)-6*l:\n            a=align(xs[t],C,D)\n            if a>=K+1:\n                rides=(a-1)//K\n                if last_exit is not None:\n                    g=t-last_exit; exit_gaps.append(g); total+=1\n                    if g<K-1: quick+=1\n                t=t+rides*l\n                last_exit=t\n            else:\n                t+=1\n    if exit_gaps:\n        import statistics\n        print(f\"  sig={sig} l={l} K={K}: visits={total}, min exit->reentry gap={min(exit_gaps)}, \"\n              f\"median={statistics.median(exit_gaps):.0f}, gaps < K-1: {quick} ({100*quick/total:.1f}%)\")\nPY","input_hash":"sha256:d06379cac6946b4ac677c9876eaf52d0ecc7656671d18baaf39eff6a220fe87a","output_hash":"sha256:494dc00