{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 400 python3 - <<'PY'\n# Controlled-length witness coverage audit (dc_10 Step 3), valid range c <= c0+2:\n# delta_c(L) = min over primitive k of max over witnesses from cycles of length <= L of |chi_k(W^2)-1|.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\ndef descend_tables(c, c0):\n    Qc=3**c; PHI=2*3**(c-1); inv2=pow(2,-1,Qc)\n    m=3**(c-1); F={}\n    for x in units(m):\n        t=(3*x+1)%Qc; row=[0]*(PHI+1); v=t\n        for b in range(1,PHI+1): v=(v*inv2)%Qc; row[b]=v\n        F[x]=row\n    level=c-1\n    while level>c0:\n        mlo=3**(level-1); new=units(mlo)\n        rho=(F[(new[0]+mlo)%(3**level)][1]*pow(F[new[0]][1],-1,Qc))%Qc\n        Fn={}\n        for xh in new:\n            t=(3*xh+1); row=[0]*(PHI+1)\n            for b in range(1,PHI+1):\n                v=(t*pow(inv2,b,3**level))%(3**level)\n                row[b]=(F[xh][b]*pow(rho,(v-(v%mlo))//mlo,Qc))%Qc\n            Fn[xh]=row\n        F=Fn; level-=1\n    return F\nimport cmath, math\ndef delta(c, c0, Lmax):\n    Qc=3**c; F=descend_tables(c,c0)\n    Q0=3**c0; U0=units(Q0); phi0=len(U0)\n    succ={}; \n    for x in U0:\n        for b in range(1,phi0+1):\n            succ[(x,b)]=((3*x+1)*pow(pow(2,b,Q0),-1,Q0))%Q0\n    cycles=[]\n    for x in U0:\n        for b1 in range(1,phi0+1):\n            v1=succ[(x,b1)]\n            if v1==x: cycles.append([(x,b1)])\n            if Lmax>=2:\n                for b2 in range(1,phi0+1):\n                    if succ[(v1,b2)]==x and v1>x: cycles.append([(x,b1),(v1,b2)])\n    def prod(cy):\n        p=1\n        for e in cy: p=(p*F[e[0]][e[1]])%Qc\n        return p\n    P=[(prod(cy),len(cy)) for cy in cycles]\n    Ws=set()\n    for i in range(len(P)):\n        for j in range(i+1,len(P)):\n            (p1,l1),(p2,l2)=P[i],P[j]\n            W=(pow(p1,l2,Qc)*pow(p2,-l1,Qc))%Qc; W2=(W*W)%Qc\n            if W2!=1: Ws.add(W2)\n    ordp=3**(c-1); dl={}; p=1\n    for j in range(ordp): dl[p]=j; p=(p*4)%Qc\n    ts=[dl[w] for w in Ws if w in dl]\n    if not ts: return None,0\n    dmin=None\n    for k in range(1,ordp):\n        if k%3==0: continue\n        sep=max(abs(cmath.exp(2j*math.pi*k*t/ordp)-1) for t in ts)\n        if dmin is None or sep<dmin: dmin=sep\n    return dmin,len(ts)\n\nprint(f\"{'c0':>3} {'c':>3} {'L':>3} {'#W^2':>5} {'delta_c(L)':>11}\")\nfor (c0,cc) in ((2,3),(2,4),(3,5),(4,6),(5,7)):\n    for L in (1,2):\n        d,n=delta(cc,c0,L)\n        print(f\"{c0:>3} {cc:>3} {L:>3} {n:>5} {d:>11.6f}\" if d else f\"{c0:>3} {cc:>3} {L:>3}  none\")\nPY"}