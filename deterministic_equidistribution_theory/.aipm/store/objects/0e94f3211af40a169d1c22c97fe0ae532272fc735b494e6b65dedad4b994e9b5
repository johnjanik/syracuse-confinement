{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 590 python3 - <<'PY'\nimport numpy as np\ndef run(c,k):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=[a for a in range(Qc) if a%3!=0]; phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/PHI) for a in U}\n    T=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t3=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t3*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W0*chi[a]\n    # mode unitary\n    js=np.arange(phi); order=[idx[pow(2,j,Qc)] for j in range(phi)]\n    Evec=np.exp(2j*np.pi*np.outer(js,np.arange(phi))/phi)/np.sqrt(phi)\n    Umat=np.zeros((2*phi,2*phi),complex); col=0\n    for ev in ((1,1),(1,-1)):\n        for t in range(phi):\n            v=np.zeros(2*phi,complex)\n            for ai in range(phi):\n                st=order[ai]\n                v[st*2+0]=ev[0]*Evec[ai,t]/np.sqrt(2)\n                v[st*2+1]=ev[1]*Evec[ai,t]/np.sqrt(2)\n            Umat[:,col]=v; col+=1\n    topmask=np.array([(t%3!=0) for ev in (0,1) for t in range(phi)])\n    K=T.T  # Koopman form\n    Km=Umat.conj().T@K@Umat\n    print(f\"c={c} k={k}:\")\n    print(f\"  ||P_top^perp K||      = {np.linalg.norm(Km[~topmask,:],2):.2e}   (ejection: Koopman image in top sector)\")\n    print(f\"  ||K P_top^perp||      = {np.linalg.norm(Km[:,~topmask],2):.2e}   (NOT claimed zero - sanity contrast)\")\n    # stationary sector cond <= 3^{c-m}, m>=1 => contained in non-top => P_stat K^m P_stat = 0\n    statmask=np.array([(t%3==0 and (t//3)%3==0) if c>=3 else False for ev in (0,1) for t in range(phi)])\n    Pst=Umat[:,statmask]@Umat[:,statmask].conj().T\n    print(f\"  ||P_stat K P_stat||   = {np.linalg.norm(Pst@K@Pst,2):.2e}   (exact ejection corollary)\")\n    # spec(K) vs spec(P_top K P_top)\n    ev_full=np.sort(np.abs(np.linalg.eigvals(K)))[::-1][:4]\n    Pt=Umat[:,topmask]@Umat[:,topmask].conj().T\n    ev_top=np.sort(np.abs(np.linalg.eigvals(Pt@K@Pt)))[::-1][:4]\n    print(f\"  top |eig| K       : {np.round(ev_full,6)}\")\n    print(f\"  top |eig| PKP_top : {np.round(ev_top,6)}\")\n    # row-sum audit m=c,c+2,2c\n    for m in (c, c+2, 2*c):\n        Tm=np.linalg.matrix_power(T,m)\n        H=Tm.conj().T@Tm\n        R=np.abs(H).sum(axis=0).max()\n        s1=np.linalg.norm(Tm,2)\n        u,s,vh=np.linalg.svd(Tm)\n        r=np.abs(vh[0,:])+1e-12\n        Rw=((np.abs(H)*r[None,:]).sum(axis=1)/r).max()\n        print(f\"  m={m:2d}: sigma1^(1/m)={s1**(1/m):.4f}  Schur R^(1/2m)={R**(1/(2*m)):.4f}  wSchur={Rw**(1/(2*m)):.4f}\")\nrun(5,1); run(6,1)\nPY"}