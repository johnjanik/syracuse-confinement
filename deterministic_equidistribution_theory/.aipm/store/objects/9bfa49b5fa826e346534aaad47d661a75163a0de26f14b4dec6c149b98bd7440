{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\nfrom math import log2\nLOG23 = log2(3.0)\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\n# ---------- 1. Strip rotation identity: spec(L_chi2) = e^{-i pi c*/R} spec(L_1) ----------\ndef build_strip(Q, s, quad, L, R, Bmax=60):\n    U = units(Q); idx = {a:i for i,a in enumerate(U)}\n    cstar = round(R*LOG23)\n    n = len(U)*(L+1)\n    M = np.zeros((n,n), complex)\n    for a in U:\n        chi = 1.0\n        if quad: chi = 1.0 if a % 3 == 1 else -1.0\n        t = (3*a+1) % Q\n        for b in range(1, Bmax+1):\n            ap = (t * pow(pow(2,b,Q), -1, Q)) % Q\n            dz = cstar - R*b\n            w = (3.0**s) * 2.0**(-(1+s)*b)\n            for z in range(L+1):\n                zp = z+dz\n                if 0 <= zp <= L:\n                    M[idx[ap]*(L+1)+zp, idx[a]*(L+1)+z] += w*chi\n    return M, cstar\n\nQ,s,L,R = 9, 0.0, 12, 2\nM1,cstar = build_strip(Q,s,False,L,R)\nM2,_     = build_strip(Q,s,True ,L,R)\ne1 = np.sort_complex(np.linalg.eigvals(M1))\ne2 = np.sort_complex(np.linalg.eigvals(M2))\nlam = np.exp(-1j*np.pi*cstar/R)\ne1r = np.sort_complex(lam*e1)\n# compare multisets\nd = np.max(np.abs(np.sort(e2.view(float)) - np.sort(e1r.view(float))))\nprint(f\"strip rotation: Q={Q} L={L} R={R} c*={cstar}: max|spec(L_chi2) - e^(-i pi c*/R) spec(L_1)| = {d:.2e}\")\n\n# ---------- 2. Functional equation brute force: psi(3a+1) = lam' psi(a) chi(a) on U ----------\nprint(\"\\n=== product-form strip coboundary candidates: psi(3a+1)=lam' psi(a) chi(a), all a in U ===\")\nfor r in (2,3,4):\n    Q = 3**r; U = units(Q); phi = len(U)\n    dlog = {}; p=1\n    for j in range(phi): dlog[p]=j; p=(p*2)%Q\n    sols = []\n    for u in range(phi):          # psi = chi_u\n        for w in range(phi):      # chi = chi_w\n            # lam' from a=1: psi(4) = lam' (psi(1)chi(1)=1)\n            lamp = np.exp(2j*np.pi*u*dlog[4 % Q]/phi)\n            ok = True\n            for a in U:\n                lhs = np.exp(2j*np.pi*u*dlog[(3*a+1)%Q]/phi)\n                rhs = lamp*np.exp(2j*np.pi*(u*dlog[a]+w*dlog[a])/phi) if False else \\\n                      lamp*np.exp(2j*np.pi*u*dlog[a]/phi)*np.exp(2j*np.pi*w*dlog[a]/phi)\n                if abs(lhs-rhs) > 1e-9: ok=False; break\n            if ok: sols.append((u,w))\n    quad = phi//2\n    print(f\"r={r} (Q={Q}, phi={phi}): solutions (psi_index u, chi_index w) = {sols}\"\n          f\"   [w=0 trivial, w={quad} = chi_2]\")\nPY"}