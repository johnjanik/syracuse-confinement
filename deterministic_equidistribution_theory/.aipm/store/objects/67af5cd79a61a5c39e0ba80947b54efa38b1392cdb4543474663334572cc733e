s(b2)\n    if all((C1[i]-C2[i])%MOD==0 for i in range(1,m)): n_locked+=1; continue  # C-locked despite b mismatch\n    res[key].append(exact_S(C1,C2))\nfor key in ('boundary','deeper'):\n    v=np.array(res[key])\n    z=(v<1e-9).mean()\n    print(f\"{key:>9}: n={len(v)}  frac(S=0)={z:.3f}  mean|S|/phi={v.mean():.4f}  \"\n          f\"nonzero |S|/phi: mean={v[v>1e-9].mean() if (v>1e-9).any() else 0:.3f}  max={v.max():.3f}\")\nprint(f\"(locked skipped: {n_locked}, tries {tries})\")\nPY\ntimeout 560 python3 c_suite/analysis/cascade_boundary_check.py","input_hash":"sha256:c4a257823e439ed9199076bf814cac20cd70544d2fce54578565c0b5d1f096c8","output_hash":"sha256:63c076ca5ffe44abe5a43520a6e0aede1dc34f0f73a62b3e97770be92cd5359a","tool":"Bash"},"time":"2026-06-10T03:58:41Z"},{"actor":{"kind":"ai_tool","tool":"Claude Code"},"event_type":"command_run","materiality_hint":{"possible_code_effect":true},"target":{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 300 python3 - <<'PY'\nimport numpy as np\n# histogram check: boundary-pair |S|/phi should be EXACTLY in {1/2, 1}\nexec(open('c_suite/analysis/cascade_boundary_check.py').read().split('res=')[0])\nrng=np.random.default_rng(11)\nvals=[]\ntries=0\nwhile len(vals)<600 and tries<200000:\n    tries+=1\n    b1=np.minimum(rng.geometric(0.5,m),40); b2=np.minimum(rng.geometric(0.5,m),40)\n    B1=b1.cumsum(); B2=b2.cumsum(); t=B1-B2\n    if not ((t[0]%6==0) and (t[1]%2==0)): continue\n    if (t[0]%18==0) and (t[1]%6==0) and (t[2]%2==0): continue   # exclude deeper\n    if (b1[:m-1]==b2[:m-1]).all(): continue\n    C1,C2=consts(b1),consts(b2)\n    if all((C1[i]-C2[i])%MOD==0 for i in range(1,m)): continue\n    vals.append(exact_S(C1,C2))\nv=np.array(vals)\nprint(f\"n={len(v)}; values within 1e-9 of 0.5: {(np.abs(v-0.5)<1e-9).mean():.4f}; of 1.0: {(np.abs(v-1.0)<1e-9).mean():.4f}; other: {((np.abs(v-0.5)>=1e-9)&(np.abs(v-1.0)>=1e-9)).mean():.4f}\")\nif ((np.abs(v-0.5)>=1e-9)&(np.abs(v-1.0)>=1e-9)).any():\n    