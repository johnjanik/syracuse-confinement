{"command":"cd /home/john/mynotes/shadow_frontier && python3 - <<'PY'\nimport numpy as np\ndef get_bnd(f):\n    d=np.load(f); Ds,eps,TH=d['Ds'],d['eps'],d['TH'].astype(float)\n    bnd=np.array([eps[np.where(TH[:,i]>=1)[0][-1]] if TH[0,i]>=1 else np.nan\n                  for i in range(len(Ds))])\n    return Ds,bnd\nD24,b24=get_bnd(\"results/window2023_lnlam_theta.npz\")\nD48,b48=get_bnd(\"results/window2023w48_lnlam_theta.npz\")\nb24i=np.interp(D48,D24,b24)\nprint(f\"max |boundary(NW=48) - boundary(NW=24)| = {np.nanmax(abs(b48-b24i)):.5f}\")\nprint(f\"mean |diff| = {np.nanmean(abs(b48-b24i)):.5f}  (eps grid step 5e-5)\")\n# slopes on COMMON physical scale h=0.03, both runs\nfor tag,D,b in [(\"NW=24\",D24,b24),(\"NW=48\",D48,b48)]:\n    out=[]\n    for Dq in (2.05,2.08,2.10,2.12,2.15,2.20):\n        i=np.argmin(abs(D-Dq)); n=max(int(0.03/(D[1]-D[0])),3)\n        sl=(b[i]-b[i-n])/(D[i]-D[i-n]); sr=(b[i+n]-b[i])/(D[i+n]-D[i])\n        out.append(f\"{Dq}:{sr-sl:+.3f}\")\n    print(f\"{tag} slope jumps (h=0.03): \"+\"  \".join(out))\nPY","description":"Proper boundary comparison NW=24 vs 48"}