{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\nfrom itertools import product\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nBcut=10\nfor n in (2,3):\n    for c in (6,7):\n        Qc=3**c; phi=2*3**(c-1)\n        dlog={}; p=1\n        for j in range(phi): dlog[p]=j; p=(p*2)%Qc\n        words=list(product(range(1,Bcut+1),repeat=n))\n        Carr=[]; Bn=[]; wts=[]\n        for w in words:\n            B=0; C=0\n            for j in range(n):\n                C=(C+pow(3,n-1-j,Qc)*pow(2,B,Qc))%Qc\n                B+=w[j]\n            Carr.append(int(C)); Bn.append(B); wts.append(2.0**(-sum(w)))\n        wts=np.array(wts); wts/=wts.sum()\n        N=len(words)\n        # character sums on sampled pairs grouped by r=v3(C_w-C_w')\n        U=units(Qc); k=1\n        tested={}\n        step=max(1,N//50)\n        for i in range(0,N,step):\n            for j in range(0,N,step):\n                if i>=j: continue\n                d=(Carr[j]-Carr[i])%Qc\n                if d==0: r=c\n                else:\n                    r=0; dd=d\n                    while dd%3==0: dd//=3; r+=1\n                if r in tested and len(tested[r])>=2: continue\n                p3n=pow(3,n,Qc)\n                S=0\n                for a in U:\n                    num=(p3n*a+Carr[i])%Qc; den=(p3n*a+Carr[j])%Qc\n                    Rv=(num*pow(den,-1,Qc)*pow(2,(Bn[j]-Bn[i])%phi,Qc))%Qc\n                    S+=np.exp(2j*np.pi*k*dlog[Rv]/phi)\n                tested.setdefault(r,[]).append(abs(S)/len(U))\n        out=\"  \".join(f\"r={r}:|C|max={max(v):.6f}\" for r,v in sorted(tested.items()))\n        print(f\"n={n} c={c}: {out}\")\n        print(f\"   prediction: EXACTLY 0 for r <= {c-2-n}; |C|=1 only at exact collision r={c}\")\nPY"}