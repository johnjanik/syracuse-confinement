{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\n# Annealed forward residue transfer operator mod 3^r, character chi on source.\n# Optionally augment state with tau = B mod 2 (valuation parity). Weight 2^-b.\ndef chi2(a): return 1.0 if a%3==1 else (-1.0 if a%3==2 else 0.0)\ndef build(r, twist, with_parity, Bmax=40):\n    Q=3**r\n    units=[a for a in range(Q) if a%3!=0]\n    inv2=pow(2,-1,Q)\n    if with_parity:\n        idx={(a,t):i for i,(a) in enumerate(units) for t in (0,1)}\n        # rebuild index properly\n        states=[(a,t) for a in units for t in (0,1)]\n    else:\n        states=[(a,0) for a in units]\n    idx={s:i for i,s in enumerate(states)}\n    n=len(states); M=np.zeros((n,n),dtype=complex)\n    for (a,t) in states:\n        ph = chi2(a) if twist else 1.0\n        for b in range(1,Bmax+1):\n            ap=( (3*a+1)%Q ) * pow(inv2,b,Q) %Q\n            tp=(t+b)%2 if with_parity else 0\n            w=2.0**(-b)\n            M[idx[(ap,tp)], idx[(a,t)]] += w*ph\n    return M\ndef rho(M): return max(abs(np.linalg.eigvals(M)))\nfor r in (2,3,4):\n    r0_res = rho(build(r,False,False)); rc_res = rho(build(r,True,False))\n    r0_par = rho(build(r,False,True));  rc_par = rho(build(r,True,True))\n    print(f\"r={r} (Q={3**r}):\")\n    print(f\"   residue-only : rho(principal)={r0_res:.6f}  rho(chi2)={rc_res:.6f}  gap_ratio={rc_res/r0_res:.6f}\")\n    print(f\"   residue x parity: rho(principal)={r0_par:.6f}  rho(chi2)={rc_par:.6f}  gap_ratio={rc_par/r0_par:.6f}\")\nPY"}