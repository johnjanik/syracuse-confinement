{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory/c_suite\necho \"=== Experiment I: shadow search ===\"\n./collatz_tests shadow-search --octave-min 20 --seeds-per-octave 20000 --moduli 9,27,81 --tilts 0,1 --char-cap 3 --delta 0.1 --apertures 6 2>&1 | tail -1\necho \"--- shadow-bearing fraction by label (does any label persistently spike?) ---\"\nawk -F, '!/^#/ && NF>=14 && $1!=\"window_id\" {n[$5]++; if($14==1)s[$5]++; sw[$5]+=$6}\n  END{ printf \"%-22s %8s %10s %10s\\n\",\"label\",\"nwin\",\"frac_shadow\",\"mean_max|W|\";\n       for(l in n) printf \"%-22s %8d %10.3f %10.4f\\n\",l,n[l],s[l]/n[l],sw[l]/n[l] }' out/shadow_search.csv\necho \"--- do shadows concentrate in long windows? max|W| vs length band ---\"\nawk -F, '!/^#/ && NF>=14 && $1!=\"window_id\" {L=$4; band=(L<16)?\"08-15\":(L<32)?\"16-31\":(L<64)?\"32-63\":\"64+\"; n[band]++; w[band]+=$6} \n  END{for(b in n) printf \"len %-6s  n=%-7d mean_max|W|=%.4f\\n\",b,n[b],w[b]/n[b]}' out/shadow_search.csv | sort"}