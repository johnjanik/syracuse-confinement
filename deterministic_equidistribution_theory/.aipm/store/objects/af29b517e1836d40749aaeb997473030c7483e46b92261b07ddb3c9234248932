{"command":"cd /home/john/mynotes/shadow_frontier && python3 - <<'PY'\nimport numpy as np\nd=np.load('results/phase_diagram_vhires.npz')\nDs,eps,TH=d['Ds'],d['eps'],d['TH'].astype(float)\n# boundary eps*(D) and D*(eps=0)\ni=int(np.searchsorted(TH[0],1.0))\nDstar=Ds[i-1]+(Ds[i]-Ds[i-1])*(1-TH[0,i-1])/(TH[0,i]-TH[0,i-1])\nbnd=np.full(len(Ds),np.nan)\nfor di in range(len(Ds)):\n    col=TH[:,di]\n    if col[0]<1: bnd[di]=0; continue\n    j=np.where(col>=1)[0]\n    bnd[di]=eps[j[-1]]\nemax=np.nanmax(bnd)\n# saturation: where boundary reaches 95% and 99% of its D=6 value\ne6=bnd[-1]\nfor frac in (0.95,0.99):\n    k=np.argmax(bnd>=frac*e6)\n    print(f\"eps*(D) reaches {int(frac*100)}% of saturation ({frac*e6:.3f}) at D = {Ds[k]:.3f}\")\nprint(f\"D* = {Dstar:.4f}; eps* at D=6: {e6:.4f}; max boundary {emax:.4f}\")\nprint(f\"eps*(D) at D = 1.5, 2, 2.5, 3, 3.5, 4: \",\n      [round(float(bnd[np.argmin(abs(Ds-q))]),3) for q in (1.5,2,2.5,3,3.5,4)])\nPY","description":"Extract candidate-region bracket from exact data"}