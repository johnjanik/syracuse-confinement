{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 300 python3 - <<'PY'\nfrom math import gcd\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\ndef descend_tables(c, c0):\n    Qc=3**c; PHI=2*3**(c-1); inv2=pow(2,-1,Qc)\n    m=3**(c-1); F={}\n    for x in units(m):\n        t=(3*x+1)%Qc; row=[0]*(PHI+1); v=t\n        for b in range(1,PHI+1): v=(v*inv2)%Qc; row[b]=v\n        F[x]=row\n    level=c-1\n    while level>c0:\n        mlo=3**(level-1); new=units(mlo)\n        rho=(F[(new[0]+mlo)%(3**level)][1]*pow(F[new[0]][1],-1,Qc))%Qc\n        Fn={}\n        for xh in new:\n            t=(3*xh+1); row=[0]*(PHI+1)\n            for b in range(1,PHI+1):\n                v=(t*pow(inv2,b,3**level))%(3**level)\n                row[b]=(F[xh][b]*pow(rho,(v-(v%mlo))//mlo,Qc))%Qc\n            Fn[xh]=row\n        F=Fn; level-=1\n    return F\nfor (c0,cc) in ((2,4),(3,5),(4,6),(5,7)):\n    Qc=3**cc; F=descend_tables(cc,c0)\n    Q0=3**c0; U0=units(Q0); phi0=len(U0)\n    succ={}; mult={}\n    for x in U0:\n        for b0 in range(1,phi0+1):\n            succ[(x,b0)]=((3*x+1)*pow(pow(2,b0,Q0),-1,Q0))%Q0\n            mult[(x,b0)]=F[x][b0]\n    cycles=[]\n    for x in U0:\n        for b1 in range(1,phi0+1):\n            v1=succ[(x,b1)]\n            if v1==x: cycles.append([(x,b1)])\n            for b2 in range(1,phi0+1):\n                if succ[(v1,b2)]==x and v1>x: cycles.append([(x,b1),(v1,b2)])\n    def prod(cy):\n        p=1\n        for e in cy: p=(p*mult[e])%Qc\n        return p\n    P=[(prod(cy),len(cy)) for cy in cycles]\n    ordp=3**(cc-1); dl={}; p=1\n    for j in range(ordp): dl[p]=j; p=(p*4)%Qc\n    g=ordp\n    for i in range(len(P)):\n        for j in range(i+1,len(P)):\n            (p1,l1),(p2,l2)=P[i],P[j]\n            W=(pow(p1,l2,Qc)*pow(p2,-l1,Qc))%Qc; W2=(W*W)%Qc\n            if W2!=1 and W2 in dl: g=gcd(g,dl[W2])\n    print(f\"c0={c0} c={cc}: gcd of witness dlogs vs ord 3^{cc-1}: g={g}  \"\n          f\"-> witness subgroup = {'FULL principal units' if g==1 else f'index {g}'}\")\nPY"}