{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\n# Step C verify: image of T lies in top-conductor modes (||(I-P_top)T|| ~ 0).\n# Step D audit: R_m = sup_a sum_{a'} |H_m(a,a')|, H_m=(T^m)*T^m; R^{1/2m} vs sigma1^{1/m};\n# plus weighted Schur with top singular vector weights.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nfor c,k in ((5,1),(6,1)):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=units(Qc); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/PHI) for a in U}\n    T=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t3=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t3*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W0*chi[a]\n    # P_top: modes eta_t with conductor exactly 3^c <=> 3 does not divide t (t != 0)\n    js=np.arange(phi)\n    order=[idx[pow(2,j,Qc)] for j in range(phi)]\n    # build full unitary state->mode (t,eps)\n    Umat=np.zeros((2*phi,2*phi),complex)\n    col=0\n    Evec=np.exp(2j*np.pi*np.outer(js,np.arange(phi))/phi)/np.sqrt(phi)\n    for eps,ev in enumerate(((1,1),(1,-1))):\n        for t in range(phi):\n            v=np.zeros(2*phi,complex)\n            for ai in range(phi):\n                st=order[ai]\n                v[st*2+0]=ev[0]*Evec[ai,t]/np.sqrt(2)\n                v[st*2+1]=ev[1]*Evec[ai,t]/np.sqrt(2)\n            Umat[:,col]=v; col+=1\n    Tm_modes=Umat.conj().T@T@Umat\n    # top-conductor mode indices: t with t%3 != 0 (conductor exactly 3^c)\n    topmask=np.array([ (t%3!=0) for eps in (0,1) for t in range(phi) ])\n    offT=np.linalg.norm(Tm_modes[~topmask,:],2)   # rows outside top = (I-P_top)T\n    print(f\"c={c} k={k}: ||(I-P_top) T||_2 = {offT:.2e}   (EJECTION: should be ~0)\")\n    for m in (c, 2*c):\n        Tm=np.linalg.matrix_power(T,m)\n        H=Tm.conj().T@Tm\n        R=np.abs(H).sum(axis=0).max()\n        s1=np.linalg.norm(Tm,2)\n        # weighted Schur: r = top singular vector magnitudes (right) of T^m\n        u,s,vh=np.linalg.svd(Tm)\n        r=np.abs(vh[0,:])+1e-12\n        Rw=((np.abs(H)*r[None,:]).sum(axis=1)/r).max()\n        print(f\"   m={m}: sigma1^(1/m)={s1**(1/m):.4f}  unweighted Schur R^(1/2m)={R**(1/(2*m)):.4f}  \"\n              f\"weighted Rw^(1/2m)={Rw**(1/(2*m)):.4f}  sqrt(Delta)=0.5774\")\nPY"}