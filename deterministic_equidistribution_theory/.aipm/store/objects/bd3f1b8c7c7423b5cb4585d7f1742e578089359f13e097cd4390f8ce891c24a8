{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport numpy as np\nfrom math import log2, gcd\n\nLOG23 = log2(3.0)\n\ndef units(Q): return [a for a in range(Q) if a % 3 != 0]\n\ndef build_par(Q, s, kchar):\n    \"\"\"Synchronized residue x parity annealed operator, character chi_k (dlog base 2),\n       source twist. Branch weight w_b = 3^s 2^{-(1+s)b}; edges collapse mod phi.\"\"\"\n    U = units(Q); phi = len(U); idx = {a:i for i,a in enumerate(U)}\n    # dlog base 2\n    dlog = {}; p = 1\n    for j in range(phi): dlog[p] = j; p = (p*2) % Q\n    inv = {a: pow(a, -1, Q) for a in U}\n    chi = {a: np.exp(2j*np.pi*kchar*dlog[a]/phi) for a in U}\n    n = 2*phi\n    M = np.zeros((n,n), complex)\n    # geometric tail: W(b0) = 3^s 2^{-(1+s) b0} / (1 - 2^{-(1+s) phi})\n    den = 1.0 - 2.0**(-(1+s)*phi)\n    for a in U:\n        t = (3*a+1) % Q\n        for ap in U:\n            # 2^{-b} = ap/t  =>  2^b = t * ap^{-1}\n            b0 = dlog[(t*inv[ap]) % Q] % phi\n            if b0 == 0: b0 = phi\n            W = (3.0**s) * 2.0**(-(1+s)*b0) / den\n            for tau in (0,1):\n                taup = (tau + b0) % 2\n                M[idx[ap]*2+taup, idx[a]*2+tau] += W * chi[a]\n    return M\n\ndef rho(M): return max(abs(np.linalg.eigvals(M)))\n\nprint(\"=== Theorem A check: residue x parity, full character group, only k=phi/2 peripheral ===\")\nfor Q in (9,27,81):\n    phi = len(units(Q))\n    for s in (0.0,1.0):\n        r0 = rho(build_par(Q,s,0))\n        ratios = {k: rho(build_par(Q,s,k))/r0 for k in range(1,phi//2+1)}\n        peripheral = [k for k,v in ratios.items() if v > 1-1e-9]\n        worst_nc = max((v for k,v in ratios.items() if k != phi//2))\n        print(f\"Q={Q:3d} s={s:.0f}: peripheral k={peripheral} (phi/2={phi//2})  \"\n              f\"max non-cob ratio={worst_nc:.6f}\")\nPY"}