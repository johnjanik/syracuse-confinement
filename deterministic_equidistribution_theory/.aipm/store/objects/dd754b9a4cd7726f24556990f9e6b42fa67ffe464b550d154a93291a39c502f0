{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 200 python3 - <<'PY'\nimport numpy as np\n# (1) verify F_chi'(x_n,x_{n+1}) = chi'(2)^{-b_n} identity on a sample orbit, c=5\nc=5; Q=3**c; PHI=2*3**(c-1)\ndlog={}; p=1\nfor j in range(PHI): dlog[p]=j; p=(p*2)%Q\ndef chi(k,x): return np.exp(2j*np.pi*k*dlog[x%Q if x%Q in dlog else None]/PHI) if (x%Q)%3 else None\nx=27; ok=0; n=0\nfor step in range(2000):\n    y=3*x+1; b=0\n    while y%2==0: y//=2; b+=1\n    k=7  # a primitive character index\n    F=np.exp(2j*np.pi*k*dlog[y%Q]/PHI)*np.exp(-2j*np.pi*k*dlog[(3*x+1)%Q]/PHI) if ((3*x+1)%Q)%3 else None\n    rhs=np.exp(-2j*np.pi*k*dlog[2]*b/PHI)\n    if F is not None:\n        n+=1\n        if abs(F-rhs)<1e-12: ok+=1\n    x=y\nprint(f\"identity F_chi'(x,Sx) = chi'(2)^-b: {ok}/{n} exact\")\n# (2) letter-mean along trajectories: typical (should -> 2) vs the known x=1 cycle (=2)\nimport random\nrandom.seed(1)\nmeans=[]\nfor trial in range(200):\n    x=random.randrange(10**8,10**9)*2+1\n    B=0;N=0\n    while x!=1 and N<5000:\n        y=3*x+1; b=0\n        while y%2==0: y//=2; b+=1\n        B+=b; N+=1; x=y\n    means.append(B/N)\nprint(f\"typical orbit letter-mean: {np.mean(means):.4f} +- {np.std(means):.4f}  (stationary 2; drift threshold log2(3)={np.log2(3):.4f})\")\nPY"}