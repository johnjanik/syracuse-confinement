{"file":{"content":"        \"iterations,residual,truncation_tail,matrix_nnz,matrix_dim\", argc, argv);\n    if (!f) { perror(\"csv_open\"); return 1; }\n\n    const int MAXIT = 3000; const ldbl TOL = 1e-11L; const int RESTARTS = 3;\n\n    for (int qi = 0; qi < c->n_moduli; qi++) {\n        uint64_t Q = c->moduli[qi];\n        for (int ti = 0; ti < c->n_tilts; ti++) {\n            ldbl s = c->tilts[ti];\n\n            /* trivial sector */\n            csr_t A0; operator_info_t i0;\n            if (rhg_build(&A0, &i0, Q, c->L, c->R, c->bmax, s, NULL, 1) != 0) {\n                fprintf(stderr, \"[spectral-gaps] Q=%llu unsupported (2^a 3^r), skipped\\n\",\n                        (unsigned long long)Q);\n                break;\n            }\n            ldbl res0; int it0;\n            ldbl rho0 = csr_spectral_radius(&A0, MAXIT, TOL, RESTARTS, &res0, &it0);\n            fprintf(f, \"%llu,%d,%d,%d,%.4Lf,trivial,0,%.10Lf,%.10Lf,1.0,%d,%.2Le,%.3Le,%zu,%d\\n\",\n                (unsigned long long)Q, c->L, c->R, c->bmax, s, rho0, rho0, it0, res0,\n                i0.trunc_tail, A0.nnz, i0.dim);\n\n            int phi_or_Q = is_pow3(Q) ? (int)(Q - Q/3) : (int)Q;\n            int kmax = c->char_cap; if (kmax > phi_or_Q - 1) kmax = phi_or_Q - 1;\n            for (int k = 1; k <= kmax; k++) {\n                character_t ch; const char *ctype;\n                if (make_char(&ch, Q, (uint64_t)k, &ctype) != 0) continue;\n                csr_t A; operator_info_t info;\n                if (rhg_build(&A, &info, Q, c->L, c->R, c->bmax, s, &ch, 1) != 0) {\n                    char_free(&ch); continue;\n                }\n                ldbl res; int it;\n                ldbl rho = csr_spectral_radius(&A, MAXIT, TOL, RESTARTS, &res, &it);\n                fprintf(f, \"%llu,%d,%d,%d,%.4Lf,%s,%d,%.10Lf,%.10Lf,%.10Lf,%d,%.2Le,%.3Le,%zu,%d\\n\",\n                    (unsigned long long)Q, c->L, c->R, c->bmax, s, ctype, k,\n                    rho, rho0, rho0 > 0 ? rho/rho0 : 0.0L, it, res,\n                    info.trunc_tail, A.nnz, info.dim);\n                csr_free(&A); char_free(&ch);\n            }\n            csr_free(&A0);\n            fprintf(stderr, \"[spectral-gaps] Q=%llu s=%.2Lf rho0=%.6Lf (dim=%d)\\n\",\n                    (unsigned long long)Q, s, rho0, i0.dim);\n        }\n    }","filePath":"/home/john/mynotes/deterministic_equidistribution_theory/c_suite/src/exp_spectral_gaps.c","numLines":45,"startLine":31,"totalLines":80},"type":"text"}