{"file_path":"/home/john/mynotes/shadow_frontier/search/candidate_tools.py","new_string":"import math\nimport numpy as np\n\nLOG23 = math.log2(3.0)\n\ndef karp_vec(nv, src, tgt, w):\n    \"\"\"Karp max cycle mean, vectorized over edges. -inf if acyclic.\"\"\"\n    INF = -1e18\n    hist = np.full((nv + 1, nv), INF)\n    hist[0, :] = 0.0\n    for k in range(1, nv + 1):\n        prev = hist[k - 1][src] + w\n        cur = np.full(nv, INF)\n        np.maximum.at(cur, tgt, prev)\n        hist[k] = cur\n    best = -np.inf\n    last = hist[nv]\n    for v in range(nv):\n        if last[v] <= INF / 2: continue\n        ks = np.where(hist[:nv, v] > INF / 2)[0]\n        if len(ks) == 0: continue\n        m = np.min((last[v] - hist[ks, v]) / (nv - ks))\n        best = max(best, m)\n    return best","old_string":"import math\nimport numpy as np\nfrom frontier import karp\n\nLOG23 = math.log2(3.0)","replace_all":false}