{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\n# Decisive uniformity test for the norm route: sigma_1(T^m)^{1/m} across c at fixed and growing m.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nprint(f\"{'c':>3} {'k':>3} {'rho(T)':>8} \" + \" \".join(f\"m={m:>2}\" for m in (4,8,12,16,20)))\nfor c,k in ((5,1),(6,1),(7,5),(8,7)):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=units(Qc); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/PHI) for a in U}\n    T=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t3=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t3*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W0*chi[a]\n    # rho via power iteration on T (avoid full eig at c=8: dim 8748²... too big dense? c=8: phi=4374, dim 8748: matrix 76M complex = 1.2GB -- too heavy. limit c<=7 for full; for c=8 use on-the-fly matvec? Skip c=8 if too big.\n    n=T.shape[0]\n    if n>6000:\n        print(f\"{c:>3} {k:>3}   (dim {n} skipped)\")\n        continue\n    rho=max(abs(np.linalg.eigvals(T))) if n<=3000 else float('nan')\n    out=[]\n    Tm=np.eye(n,dtype=complex); mm=0\n    for m in (4,8,12,16,20):\n        while mm<m:\n            Tm=Tm@T; mm+=1\n        out.append(np.linalg.norm(Tm,2)**(1/m))\n    print(f\"{c:>3} {k:>3} {rho:8.4f} \" + \" \".join(f\"{v:.4f}\" for v in out))\nPY"}