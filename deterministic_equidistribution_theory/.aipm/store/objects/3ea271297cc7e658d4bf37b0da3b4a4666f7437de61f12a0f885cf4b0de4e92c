{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 400 python3 - <<'PY'\nimport numpy as np\n# Linchpin check: tr((T^m)* T^m) = dim * Delta^m + thin(B != B')\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nfor c,k in ((6,1),(7,5)):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=units(Qc); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chi={a: np.exp(2j*np.pi*k*dlog[a]/PHI) for a in U}\n    T=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W0*chi[a]\n    dim=2*phi\n    Tm=np.eye(dim,dtype=complex)\n    for m in (1,2,3,4):\n        Tm=Tm@T\n        fro2=np.linalg.norm(Tm,'fro')**2\n        pred=dim*(1/3.0)**m\n        print(f\"c={c} k={k} m={m}: tr((T^m)*T^m) = {fro2:.4f}   dim*Delta^m = {pred:.4f}   \"\n              f\"excess(thin sector) = {fro2/pred-1:+.4%}\")\nPY"}