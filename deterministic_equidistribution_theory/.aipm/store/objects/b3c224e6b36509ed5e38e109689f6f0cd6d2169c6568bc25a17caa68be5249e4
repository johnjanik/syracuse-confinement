{"file":{"content":"#include \"residue_height_graph.h\"\n#include \"modarith.h\"\n#include <math.h>\n\nint rhg_build(csr_t *out, operator_info_t *info,\n              uint64_t Q, int L, int R, int Bmax, ldbl s,\n              const character_t *chi, int use_height) {\n    int even = (Q % 2 == 0);\n    int div3 = (Q % 3 == 0);\n    if (even && div3) return 1;                 /* mixed 2^a 3^r: unsupported here */\n\n    int forward = !even;                        /* Q odd -> forward map */\n    uint64_t inv2 = 0, inv3 = 0;\n    if (forward) inv2 = ma_inv(2, Q);           /* exists: Q odd */\n    else         inv3 = ma_inv(3, Q);           /* exists: gcd(3,Q)=1 since !div3 */\n\n    int Zsize = use_height ? (L + 1) : 1;\n    long n = (long)Q * Zsize;\n\n    triplets_t t; tri_init(&t, (int)n);\n\n    for (uint64_t a = 0; a < Q; a++) {\n        cldbl phase = chi ? char_value(chi, a) : (1.0L + 0.0L * I);\n        for (int b = 1; b <= Bmax; b++) {\n            uint64_t ap;\n            if (forward) {\n                uint64_t f = (3 * a + 1) % Q;\n                ap = ma_mulmod(f, ma_powmod(inv2, (uint64_t)b, Q), Q);\n            } else {\n                uint64_t p2 = ma_powmod(2, (uint64_t)b, Q);\n                uint64_t val = (ma_mulmod(p2, a, Q) + Q - 1) % Q;\n                ap = ma_mulmod(inv3, val, Q);\n            }\n            ldbl ws = powl(2.0L, -(ldbl)b) * powl(2.0L, s * (LOG2_3 - (ldbl)b));\n            cldbl w = ws * phase;\n\n            if (!use_height) {\n                tri_add(&t, (int)ap, (int)a, w);\n            } else {\n                int dz = (int)lroundl((ldbl)R * (LOG2_3 - (ldbl)b));\n                for (int z = 0; z <= L; z++) {\n                    int zp = z + dz;\n                    if (zp < 0 || zp > L) continue;       /* killed at boundary */\n                    int row = (int)ap * Zsize + zp;\n                    int col = (int)a  * Zsize + z;\n                    tri_add(&t, row, col, w);\n                }\n            }\n        }\n    }\n\n    *out = csr_from_triplets(&t);\n    tri_free(&t);\n\n    if (info) {\n        info->Q = Q; info->L = L; info->R = R; info->Bmax = Bmax; info->s = s;\n        info->use_height = use_height;\n        info->dim = (int)n; info->nnz = out->nnz;\n        info->trunc_tail = powl(2.0L, -(ldbl)Bmax);\n        info->map_mode = forward ? 0 : 1;\n    }\n    return 0;\n}\n","filePath":"/home/john/mynotes/deterministic_equidistribution_theory/c_suite/src/residue_height_graph.c","numLines":64,"startLine":1,"totalLines":64},"type":"text"}