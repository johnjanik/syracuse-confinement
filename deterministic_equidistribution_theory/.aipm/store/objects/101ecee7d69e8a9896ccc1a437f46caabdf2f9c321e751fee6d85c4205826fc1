{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\n# Is the mod-9 reduction of the annealed dynamics autonomous (independent of r)?\n# x' mod 9 = (3a+1)*2^{-b} mod 9. 3a+1 mod 9 depends only on a mod 3.\nfor amod9 in range(9):\n    if amod9%3==0: continue\n    print(f\"a≡{amod9} mod9 (a≡{amod9%3} mod3): 3a+1≡{(3*amod9+1)%9} mod9  -> depends only on a mod 3\")\nprint(\"=> (3a+1) mod 9 depends only on a mod 3; with 2^{-b} this gives an autonomous mod-9 chain, INDEPENDENT of r.\\n\")\n\n# gap ratio by character ORDER/CONDUCTOR, sync full-group data Q=9,27,81 (s=0)\nimport csv,math\ndef analyze(path,Q,scol=\"0.0000\"):\n    phi=Q-Q//3\n    rows=[]\n    for line in open(path):\n        if line.startswith('#') or line.startswith('Q,L'): continue\n        f=line.strip().split(',')\n        if len(f)<17 or f[5]=='trivial' or f[4]!=scol: continue\n        k=int(f[6]); ratio=float(f[16])\n        order=phi//math.gcd(k,phi)\n        # conductor 3^c: order=2*3^j or 3^j -> c=j+1 ; compute via order's 3-part\n        o=order; j=0\n        while o%3==0: o//=3; j+=1\n        cond=3**(j+1)\n        rows.append((k,order,cond,ratio))\n    # worst (max ratio) per conductor\n    bycond={}\n    for k,o,c,r in rows:\n        bycond.setdefault(c,[]).append(r)\n    print(f\"Q={Q} (phi={phi}), s=0:  max gap_ratio by character conductor:\")\n    for c in sorted(bycond):\n        print(f\"   conductor {c:>5}: max ratio={max(bycond[c]):.4f}  (n={len(bycond[c])})\")\nanalyze(\"c_suite/out_kappa/spectral_gaps.csv\",9)\nanalyze(\"c_suite/out_kappa/spectral_gaps.csv\",27)\nanalyze(\"c_suite/out_kappa/spectral_gaps.csv\",81)\nanalyze(\"/tmp/sync243/spectral_gaps.csv\",243)\nPY"}