{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\nfrom itertools import product\nimport random\n# dc_15 audits:\n# (6) collision entropy: 3^c * Col_m(c) for m = alpha*c  (want: poly-bounded, ideally ~K)\n# (5) Fourier flattening profile max_{v3(u)=j}|F_m(u)| (Monte Carlo for larger c)\n# plus the WINDOW prediction: Col(C) <= K * Col(window) with Col(window) ~ Delta^{c-1}*poly\nrng=random.Random(11)\ndef sample_C(m,c,r=0.5):\n    Qc=3**c\n    B=0; C=0\n    for j in range(m):\n        C=(3*C+pow(2,B,Qc*2**0))%Qc if False else (3*C+pow(2,B,Qc))%Qc\n        # note: C_{j+1} = 3C_j + 2^{B_j}; using recursion form\n        b=1\n        while rng.random()>= (1-r): b+=1   # geometric(1-r) on {1,2,...}\n        B+=b\n    return C\n# careful: recursion C_{j+1}=3C_j+2^{B_j} builds C_w = sum 3^{m-1-j}2^{B_j} ✓\ndef col_estimate(m,c,N):\n    from collections import Counter\n    cnt=Counter(sample_C(m,c) for _ in range(N))\n    # unbiased collision estimator: sum n_i(n_i-1)/(N(N-1))\n    s=sum(v*(v-1) for v in cnt.values())\n    return s/(N*(N-1))\nprint(\"=== 3^c * Col_m(c), s=0 (Monte Carlo, N=200k) ===\")\nprint(f\"{'c':>3} {'m=c':>10} {'m=1.5c':>10} {'m=2c':>10}   (pigeonhole floor = 1)\")\nfor c in (4,5,6,7,8):\n    row=[]\n    for alpha in (1.0,1.5,2.0):\n        m=int(alpha*c)\n        col=col_estimate(m,c,200000)\n        row.append(3**c*col)\n    print(f\"{c:>3} {row[0]:>10.3f} {row[1]:>10.3f} {row[2]:>10.3f}\")\nPY"}