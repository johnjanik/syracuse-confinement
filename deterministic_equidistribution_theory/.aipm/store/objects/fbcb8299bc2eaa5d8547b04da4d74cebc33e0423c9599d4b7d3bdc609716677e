{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 560 python3 - <<'PY'\nimport numpy as np\n# Chain-trace scaling audit: P = (T^m)* T^m;  tr(P^k) vs candidate laws.\n# Also rho(P) = ||T^m||^2 and rho(T) for reference.\ndef units(Q): return [a for a in range(Q) if a%3!=0]\nfor c,k0 in ((6,1),(7,5)):\n    Qc=3**c; PHI=2*3**(c-1); q=0.5; den=1-q**PHI\n    dlog={}; p=1\n    for j in range(PHI): dlog[p]=j; p=(p*2)%Qc\n    U=units(Qc); phi=len(U); idx={a:i for i,a in enumerate(U)}\n    inv={a:pow(a,-1,Qc) for a in U}\n    chi={a: np.exp(2j*np.pi*k0*dlog[a]/PHI) for a in U}\n    T=np.zeros((2*phi,2*phi),complex)\n    for a in U:\n        t=(3*a+1)%Qc\n        for ap in U:\n            b0=dlog[(t*inv[ap])%Qc]%PHI\n            if b0==0: b0=PHI\n            W0=q**b0/den\n            for tau in (0,1):\n                T[idx[ap]*2+(tau+b0)%2, idx[a]*2+tau]+=W0*chi[a]\n    dim=2*phi\n    rhoT=max(abs(np.linalg.eigvals(T)))\n    print(f\"c={c} k={k0}: dim={dim} rho(T)={rhoT:.4f}  sqrt(Delta)=0.5774\")\n    for m in (2,3,4):\n        Tm=np.linalg.matrix_power(T,m)\n        P=Tm.conj().T@Tm\n        ev=np.linalg.eigvalsh((P+P.conj().T)/2).real\n        ev=np.clip(ev,0,None)\n        for kk in (1,2,3):\n            trk=(ev**kk).sum()\n            # candidate normalizations\n            n1=dim*(1/3.0)**(m*kk)            # dim * Delta^{mk}\n            n2=dim*(1/3.0)**((m-1)*kk)        # dim * Delta^{(m-1)k}\n            print(f\"   m={m} k={kk}: tr(P^k)={trk:10.4f}   dim*D^(mk)={n1:9.4f} (ratio {trk/n1:8.3f})\"\n                  f\"   dim*D^((m-1)k)={n2:9.4f} (ratio {trk/n2:8.3f})   rho(P)^k={(ev.max())**kk:8.4f}\")\nPY"}