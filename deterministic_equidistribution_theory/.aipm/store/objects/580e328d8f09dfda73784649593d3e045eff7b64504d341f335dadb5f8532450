{"command":"cd /home/john/mynotes/shadow_frontier && python3 - <<'PY'\nimport numpy as np, math\n# (1) kink sharpness: boundary slope left/right of 1.5 at shrinking scales\nd=np.load('results/kink15_lnlam_theta.npz'); Ds,eps,TH=d['Ds'],d['eps'],d['TH'].astype(float)\nbnd=np.array([eps[np.where(TH[:,i]>=1)[0][-1]] if TH[0,i]>=1 else np.nan for i in range(len(Ds))])\ni0=np.argmin(abs(Ds-1.5))\nprint(\"kink at D=1.5: boundary slope (left, right) at scale h:\")\nfor h in (0.04, 0.02, 0.01, 0.005):\n    n=int(h/(Ds[1]-Ds[0]))\n    sl=(bnd[i0]-bnd[i0-n])/h; sr=(bnd[i0+n]-bnd[i0])/h\n    print(f\"  h={h}: left {sl:.4f}  right {sr:.4f}  jump {sr-sl:+.4f}\")\n\n# (2) interior basin floor vs predicted natural bias of calibrated geometric law\nL23=math.log2(3); q=1-1/L23\nz=complex(math.cos(-2*math.pi/3),math.sin(-2*math.pi/3))   # z^{-1} as value\nG=sum(0.5**b*(z**b) for b in range(1,300))\nEcal=(1-q)*sum(q**(b-1)*z**b for b in range(1,300))\nprint(f\"\\npredicted basin floor (natural bias of calibrated geometric law): \"\n      f\"|E_cal - G| = {abs(Ecal-G):.4f}\")\ndi=np.load('results/interior_lnlam_theta.npz'); Ds2,eps2,TH2=di['Ds'],di['eps'],di['TH'].astype(float)\nprint(\"measured basin floor eps_nat(D) (where dtheta/deps leaves 0):\")\nfor Dq in (2.5,3.0,3.5,4.0):\n    i=np.argmin(abs(Ds2-Dq))\n    col=TH2[:,i]; dcol=np.gradient(col,eps2)\n    j=np.argmax(dcol< -0.02)   # first eps where theta starts dropping\n    print(f\"  D={Dq}: eps_nat = {eps2[j]:.4f}\")\nPY","description":"Quantify kink sharpness and basin floor"}