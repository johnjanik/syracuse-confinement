{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\npython3 - <<'PY'\nimport math\ndef analyze(path,Q,scol=\"0.0000\"):\n    phi=Q-Q//3\n    bycond={}\n    for line in open(path):\n        if line.startswith('#') or line.startswith('Q,L'): continue\n        f=line.strip().split(',')\n        if len(f)<17 or f[5]=='trivial': continue\n        if int(f[0])!=Q or f[4]!=scol: continue          # FILTER by Q and s\n        k=int(f[6]); ratio=float(f[16])\n        order=phi//math.gcd(k,phi)\n        o=order; j=0\n        while o%3==0: o//=3; j+=1\n        cond=3**(j+1) if order>1 else 1\n        bycond.setdefault(cond,[]).append((k,order,ratio))\n    print(f\"Q={Q} (phi={phi}), s=0:\")\n    for c in sorted(bycond):\n        mx=max(bycond[c],key=lambda t:t[2])\n        print(f\"   conductor {c:>5}: max ratio={mx[2]:.4f} (k={mx[0]},order={mx[1]}, n={len(bycond[c])})\")\nfor p,Q in [(\"c_suite/out_kappa/spectral_gaps.csv\",9),\n            (\"c_suite/out_kappa/spectral_gaps.csv\",27),\n            (\"c_suite/out_kappa/spectral_gaps.csv\",81),\n            (\"/tmp/sync243/spectral_gaps.csv\",243)]:\n    analyze(p,Q)\nPY"}