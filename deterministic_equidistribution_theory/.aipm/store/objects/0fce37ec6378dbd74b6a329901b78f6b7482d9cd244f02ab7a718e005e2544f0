{"command":"cd /home/john/mynotes/deterministic_equidistribution_theory\ntimeout 400 python3 - <<'PY'\nimport random\n# Diagnostic: true valuation of the log-derivative L(a) = sum_i 3^i DC_i/(D_i D'_i)\n# vs nominal d_R = min_i [i + v3(DC_i)], and vs observed vanish threshold.\nrng=random.Random(7)\nc=8; Qc=3**c\ndef prefC(word,i):\n    B=0; C=0\n    for j in range(i):\n        C=(3*C+pow(2,B,Qc))%Qc\n        B+=word[j]\n    return C\ndef v3(x):\n    x%=Qc\n    if x==0: return 99\n    v=0\n    while x%3==0: x//=3; v+=1\n    return v\nn=4\nfrom collections import Counter\ntab=Counter()\nfor trial in range(3000):\n    w =[rng.randint(1,8) for _ in range(n)]\n    wp=[rng.randint(1,8) for _ in range(n)]\n    a=rng.choice([x for x in range(1,Qc) if x%3!=0])\n    L=0; dnom=None\n    for i in range(1,n):\n        Ci=prefC(w,i); Cpi=prefC(wp,i)\n        DC=(Cpi-Ci)%Qc\n        if DC==0: continue\n        Di=(pow(3,i,Qc)*a+Ci)%Qc; Dpi=(pow(3,i,Qc)*a+Cpi)%Qc\n        L=(L+pow(3,i,Qc)*DC*pow(Di*Dpi,-1,Qc))%Qc\n        val=i+v3(DC)\n        dnom=val if dnom is None else min(dnom,val)\n    if dnom is None: continue\n    tab[(dnom, v3(L))]+=1\nprint(\"nominal d_R  vs  true v3(L):  count\")\nfor key in sorted(tab):\n    print(f\"   d_nom={key[0]:2d}  v3(L)={key[1]:2d}   {tab[key]}\")\nPY"}