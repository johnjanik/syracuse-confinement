{"command":"cd /home/john/mynotes/shadow_frontier && python3 - <<'PY'\nimport numpy as np, math\nL=math.log2(3); z=complex(math.cos(-2*math.pi/3),math.sin(-2*math.pi/3))  # zeta3^-1\nG=sum(0.5**b*z**b for b in range(1,300))  # z**b cycles since z=zeta3^-1\np=2-L\nv=p*z+(1-p)*z**2   # b=1 -> zeta3^-1, b=2 -> zeta3^-2 = zeta3\nprint(f\"binary ceiling |v-G| = {abs(v-G):.5f}\")\n\nlnlam=np.fromfile('results/vhires_lnlam.bin').reshape(2000,24,400)\nDs=np.linspace(0.6,6.0,2000); ts=np.concatenate([[0.0],np.geomspace(0.2,20,399)])\neps=np.linspace(0.0,0.6,3000)\nfor Dq in [1.0,1.2,1.30,1.5,2.0,2.5,3.0,4.0]:\n    di=int(np.argmin(abs(Ds-Dq)))\n    th=(np.min(lnlam[di][:,:,None]-ts[None,:,None]*eps[None,None,:],axis=1).max(0))/math.log(2)\n    dth=np.gradient(th,eps)\n    # cliff = eps of steepest descent; also curvature spike location\n    ecliff=eps[int(np.argmin(np.gradient(dth,eps)))]\n    # theta just below/above 0.449\n    i449=int(np.argmin(abs(eps-0.4490)))\n    print(f\"D={Dq}: steepest-curvature eps={ecliff:.4f}   theta(0.43)={th[int(np.argmin(abs(eps-0.43)))]:.3f}  theta(0.449)={th[i449]:.3f}  theta(0.47)={th[int(np.argmin(abs(eps-0.47)))]:.3f}\")\nPY","description":"Test binary-ceiling hypothesis against lambda tensor"}